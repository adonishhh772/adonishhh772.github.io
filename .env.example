# ------------------------------------------------------------------
# NEWSLETTER_FORM_URL
#
# The single configuration value that wires up the newsletter form.
# When set, the sign-up form on the homepage, writing page and at the
# end of every article POSTs an `email` field to this URL (for example
# a Buttondown, ConvertKit or Mailchimp hosted form endpoint).
#
# When unset (or empty) the site instead shows a graceful placeholder
# message: "Daily issues are launching soon. Follow on LinkedIn in the
# meantime." — no broken form, no dead endpoint.
#
# Copy this file to `.env` and fill in the value before connecting a
# real email provider.
# ------------------------------------------------------------------
NEWSLETTER_FORM_URL=

# ------------------------------------------------------------------
# CONTACT_ACCESS_KEY
#
# Free Web3Forms access key that powers the "Get in touch" form on
# /contact. Get one at https://web3forms.com (enter your email, the key
# arrives by email) and paste it here.
#
# When empty, the contact page shows a mailto button instead of a form,
# so nothing ever looks broken.
# ------------------------------------------------------------------
CONTACT_ACCESS_KEY=

# ------------------------------------------------------------------
# BOOKING_URL
#
# Your scheduling link for the "Schedule a meeting" buttons — for
# example a free Cal.com page (https://cal.com/your-name) or Calendly.
#
# When empty, the site offers to arrange a call by email instead.
# ------------------------------------------------------------------
BOOKING_URL=

# ------------------------------------------------------------------
# PUBLIC_VISITOR_STATS_URL
#
# Base URL of the Cloudflare Worker in workers/visitor-stats (deploy once).
# Example: https://abdbastola-visitor-stats.<your-subdomain>.workers.dev
#
# The site shows "You are visitor #N" on the campus identity card and counts
# Gather live-app opens. Unique visitors are deduplicated by IP on the worker
# (hashed; raw IPs are not stored).
#
# GitHub Pages build: Settings → Secrets and variables → Actions → Variables
# ------------------------------------------------------------------
PUBLIC_VISITOR_STATS_URL=
