---
// "By the numbers" band with count-up animation.
// Values are real and verifiable: career start Oct 2017, KAI platform users and
// network nodes from the CV, repositories from the public GitHub API.
interface Stat {
  value: number;
  suffix?: string;
  label: string;
}

const stats: Stat[] = [
  { value: 7, suffix: '+', label: 'Years in AI & ML' },
  { value: 65000, suffix: '+', label: 'Users on the KAI platform' },
  { value: 200, suffix: '+', label: 'Network nodes optimised' },
  { value: 26, label: 'Public repositories' },
];

const format = (n: number) => n.toLocaleString('en-GB');
---

<section class="section section--tight" aria-label="By the numbers">
  <div class="wrap">
    <div class="stats-band card">
      {
        stats.map((stat, i) => (
          <div class="stat" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span
              class="stat-value"
              data-count-to={stat.value}
              data-suffix={stat.suffix ?? ''}
            >
              {format(stat.value)}
              {stat.suffix ?? ''}
            </span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

{/*
  The count-up is driven by the delegated controller in
  src/lib/world/page-controls.ts. The final numbers are in the markup, so a
  visitor with no JavaScript or reduced motion simply reads them.
*/}
