---
// Minimal geometric icon set (inline SVG, currentColor).
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'github'
    | 'linkedin'
    | 'rss'
    | 'coffee'
    | 'mail';
  size?: number;
}

const { name, size = 18 } = Astro.props;

const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.8',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const;
---

{
  name === 'arrow-right' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      aria-hidden="true"
      {...stroke}
    >
      <path d="M4 12h15" />
      <path d="m13 5 7 7-7 7" />
    </svg>
  )
}
{
  name === 'arrow-up-right' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      aria-hidden="true"
      {...stroke}
    >
      <path d="M7 17 17 7" />
      <path d="M8.5 7H17v8.5" />
