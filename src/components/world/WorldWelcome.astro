---
/**
 * The welcome card.
 *
 * A visitor who has never been here arrives at a still frame of a strange
 * little world with no idea that it makes a sound. The card answers the two
 * questions they actually have — what is this, and do I want audio — and it
 * does it before the world starts, because a browser will not allow music
 * without a gesture anyway.
 *
 * Both answers are equal. "Enter with sound" is not the primary action and
 * "Enter silently" is not a dismissal: the music is optional, and the card
 * says so. It appears once per browsing context, never again, and it is
 * skipped entirely for a visitor whose preference is already stored.
 */
import { site, hero } from '../../site.config';
---

<div class="world-welcome" data-world-welcome hidden>
  <div
    class="world-welcome-card"
    role="dialog"
    aria-modal="false"
    aria-labelledby="welcome-title"
    aria-describedby="welcome-body"
    data-world-welcome-card
  >
    <p class="world-welcome-kicker mono">{hero.eyebrow}</p>
    <h2 class="world-welcome-title" id="welcome-title">
      Welcome to the observatory<span class="dot">.</span>
    </h2>
    <p class="world-welcome-body" id="welcome-body">
      {site.name}'s whole portfolio — the CV, every case study, every article and
      the contact station — is a set of places in the miniature campus behind
      this card. There is calm instrumental music for the room, if you would
      like it.
    </p>
    <div class="world-welcome-actions">
      <button class="btn btn--primary" type="button" data-world-enter="sound">
        Enter with sound
      </button>
      <button class="btn btn--ghost" type="button" data-world-enter="silent">
        Enter silently
      </button>
    </div>
    <p class="world-welcome-foot">
      Sound is optional and always under your control — the volume and mute
      buttons sit in the bar at all times, and nothing plays unless you ask.
    </p>
  </div>
</div>

<script>
  import { ambient, hasVisited, markVisited, readSoundPreference } from '../../lib/world/audio';

  const CARD_KEY = '__abdWorldWelcome';

  function boot(): void {
    const host = window as unknown as Record<string, unknown>;
    /* Once per page load, and the element is not persisted, so this cannot
       bind twice to the same card. */
    if (host[CARD_KEY]) return;
    host[CARD_KEY] = true;

    const card = document.querySelector<HTMLElement>('[data-world-welcome]');
    if (!card) return;

    const close = () => {
      if (card.hidden) return;
      card.dataset.leaving = 'true';
      /*
       * Focus is handed to the map control rather than left on a button that
       * no longer exists — a keyboard visitor answered the card, and the next
       * Tab should reach the world rather than the body.
       */
      if (card.contains(document.activeElement)) {
        document
          .querySelector<HTMLElement>('[data-world-chrome] [data-world-map]')
          ?.focus({ preventScroll: true });
      }
      window.setTimeout(() => {
        card.hidden = true;
        card.dataset.leaving = 'false';
      }, 420);
    };

    const answer = (choice: 'sound' | 'silent') => {
      markVisited();
      if (choice === 'sound') {
        /* The gesture is this click, so this is the moment the browser will
           allow a context — and the only moment it is asked for. */
        void ambient().play({ fadeMs: 2600 });
      }
      close();
    };

    for (const button of card.querySelectorAll<HTMLElement>('[data-world-enter]')) {
      button.addEventListener('click', () => {
        const choice = button.dataset.worldEnter === 'sound' ? 'sound' : 'silent';
        answer(choice);
      });
    }

    /*
     * The card never traps the visitor.
     *
     * It is a welcome, not a gate: the scrim does not take pointer events, and
     * pressing the world or the canvas behind it while it is up means "silent
     * entry" rather than doing nothing. That also means a visitor who ignores
     * it is never stuck behind it — and neither is anything driving the page
     * programmatically.
     */
    const dismissOnWorld = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-world-welcome-card]')) return;
      markVisited();
      close();
    };
    document.addEventListener('pointerdown', dismissOnWorld, true);
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      dismissOnWorld(event);
    });

    /*
     * Only a visitor who has never answered sees the card. Anyone whose
     * preference is already stored is let straight through — and if they asked
     * for sound before, the sound controls try to honour that on their first
     * gesture rather than pretending it can autoplay.
     */
    const first = !hasVisited() && readSoundPreference() === 'unset';
    if (!first) return;
    card.hidden = false;
    const primary = card.querySelector<HTMLElement>('[data-world-enter="sound"]');
    primary?.focus({ preventScroll: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>

<style>
  .world-welcome {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--bg) 58%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    /*
     * The scrim is decoration, not a wall. The card takes the pointer, the
     * space around it does not, so the world behind stays reachable and a
     * visitor can never be stuck behind a welcome they did not ask for.
     */
    pointer-events: none;
    animation: welcome-in 520ms var(--ease-out) both;
  }

  .world-welcome[hidden] {
    display: none;
  }

  .world-welcome[data-leaving='true'] {
    opacity: 0;
    transition: opacity 420ms var(--ease-out);
  }

  @keyframes welcome-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .world-welcome-card {
    width: min(31rem, 100%);
    padding: clamp(1.5rem, 4vw, 2.3rem);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-2);
    pointer-events: auto;
    animation: welcome-card-in 620ms var(--ease-out) 60ms both;
  }

  @keyframes welcome-card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .world-welcome-kicker {
    margin: 0 0 0.7rem;
    color: var(--accent);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .world-welcome-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 8, 'WONK' 1;
    font-size: var(--step-2);
    font-weight: 620;
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .world-welcome-title .dot {
    color: var(--accent);
  }

  .world-welcome-body {
    margin: 0 0 1.3rem;
    color: var(--text-soft);
    font-size: 0.96rem;
    line-height: 1.62;
  }

  .world-welcome-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .world-welcome-foot {
    margin: 1rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline);
    color: var(--faint);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  @media (max-width: 520px) {
    .world-welcome-actions {
      flex-direction: column;
    }

    .world-welcome-actions .btn {
      justify-content: center;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .world-welcome,
    .world-welcome-card {
      animation: none;
    }

    .world-welcome[data-leaving='true'] {
      transition: none;
    }
  }
</style>
