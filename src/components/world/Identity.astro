---
/**
 * The campus identity.
 *
 * This is not navigation — the world is the navigation. It is the one piece
 * of standing text that says whose site this is, and it doubles as the
 * document heading in both modes: a compact caption in the corner while the
 * world is running, the opening of the page when it is not.
 */
import { site, hero } from '../../site.config';
import VisitorStats from '../VisitorStats/VisitorStats.astro';

const eyebrowRole = hero.eyebrow.split(' · ')[0] ?? hero.eyebrow;
---

<section class="world-identity" aria-labelledby="identity-title">
  <p class="identity-eyebrow">
    <span class="status-dot" aria-hidden="true"></span>
    <span class="mono identity-eyebrow-line">
      <span class="identity-eyebrow-role">{eyebrowRole}</span>
      <span class="identity-eyebrow-sep" aria-hidden="true"> · </span>
      <span class="identity-eyebrow-location">{site.location}</span>
    </span>
  </p>

  <h1 class="identity-name" id="identity-title">
    {site.name}<span class="dot">.</span>
  </h1>

  <p class="identity-headline">{hero.headline}</p>
  <p class="identity-lead">{hero.lead}</p>

  <p class="identity-currently">
    <strong>Currently</strong>
    {hero.currently}
  </p>

  <VisitorStats />
</section>

<style>
  /*
    Simple mode is the readable page, so the identity becomes its opening:
    same container as the rest of the page, full display sizes. The world-mode
    rules below override all of this into a corner caption.
  */
  .world-identity {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) clamp(1.2rem, 2.6vw, 2.2rem);
  }

  .identity-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.55rem;
  }

  .identity-eyebrow .mono {
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .identity-eyebrow-line {
    line-height: 1.35;
  }

  .identity-name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 8, 'WONK' 1;
    font-size: var(--step-5);
    font-weight: 620;
    line-height: 1;
    letter-spacing: -0.028em;
  }

  .identity-name .dot {
    color: var(--accent);
  }

  .identity-headline {
    margin: 0 0 0.9rem;
    font-size: var(--step-3);
    line-height: 1.28;
    letter-spacing: -0.012em;
    font-weight: 450;
    color: var(--text-soft);
    text-wrap: balance;
  }

  .identity-lead {
    margin: 0 0 1rem;
    max-width: 52ch;
    color: var(--muted);
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .identity-currently {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .identity-currently strong {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    margin-right: 0.4rem;
  }

  /*
    While the world is running this is a caption in the corner: it must not
    read as navigation and must not swallow a drag, so it ignores the pointer
    entirely. In simple mode the same markup is the opening of the page.

    The card also carries a soft scrim of its own. The island is wide, so the
    two can meet on a desktop; a gradient that fades out toward the top and the
    right keeps the words legible where they touch the scenery without drawing
    a visible panel across the picture — which is what a filled card would do.
  */
  :global(html[data-mode='world']) .world-identity {
    position: fixed;
    left: clamp(1rem, 2.5vw, 2.2rem);
    top: 50%;
    bottom: auto;
    z-index: 20;
    width: min(24rem, 26vw);
    max-width: none;
    margin: 0;
    padding: 0 clamp(0.2rem, 1vw, 0.6rem) 0 0;
    pointer-events: none;
    transform: translateY(-50%);
  }

  :global(html[data-mode='world']) .world-identity::before {
    content: '';
    position: absolute;
    inset: -2.5rem -4rem -2.5rem -2.5rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      120% 90% at 0% 50%,
      color-mix(in srgb, var(--bg) 86%, transparent) 0%,
      color-mix(in srgb, var(--bg) 52%, transparent) 48%,
      transparent 82%
    );
  }

  :global(html[data-mode='world']) .identity-lead {
    font-size: 0.84rem;
    max-width: 38ch;
  }

  :global(html[data-mode='world']) .identity-name {
    font-size: clamp(1.35rem, 1.8vw, 1.75rem);
  }

  :global(html[data-mode='world']) .identity-headline {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
  }

  /* Phones: keep it, but clear of the control bar above and the sheet below. */
  @media (max-width: 860px) {
    :global(html[data-mode='world']) .world-identity {
      left: calc(0.9rem + env(safe-area-inset-left, 0px));
      right: calc(0.9rem + env(safe-area-inset-right, 0px));
      bottom: auto;
      top: calc(5.65rem + env(safe-area-inset-top, 0px));
      width: auto;
      max-width: none;
      box-sizing: border-box;
      padding-right: 0;
      transform: none;
      text-align: left;
    }

    :global(html[data-mode='world']) .identity-eyebrow {
      align-items: flex-start;
    }

    :global(html[data-mode='world']) .identity-eyebrow-line {
      white-space: normal;
      text-wrap: balance;
    }

    :global(html[data-mode='world']) .identity-eyebrow-sep,
    :global(html[data-mode='world']) .identity-eyebrow-location {
      display: none;
    }

    :global(html[data-mode='world']) .identity-lead,
    :global(html[data-mode='world']) .identity-currently,
    :global(html[data-mode='world']) .identity-headline {
      display: none;
    }

    :global(html[data-mode='world']) .identity-name {
      font-size: clamp(1.15rem, 5.2vw, 1.35rem);
      line-height: 1.08;
      text-wrap: balance;
    }
  }

  @keyframes identity-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-mode='world']) .world-identity {
      animation: none;
    }
  }
</style>
