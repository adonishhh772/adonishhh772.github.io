---
/**
 * The campus identity.
 *
 * This is not navigation — the world is the navigation. It is the one piece
 * of standing text that says whose site this is, and it doubles as the
 * document heading in both modes: a compact caption in the corner while the
 * world is running, the opening of the page when it is not.
 */
import { site, hero } from '../../site.config';
import VisitorStats from '../VisitorStats/VisitorStats.astro';

const eyebrowRole = hero.eyebrow.split(' · ')[0] ?? hero.eyebrow;
---

<section class="world-identity" data-world-no-gesture aria-labelledby="identity-title">
  <p class="identity-eyebrow">
    <span class="status-dot" aria-hidden="true"></span>
    <span class="mono identity-eyebrow-line">
      <span class="identity-eyebrow-role">{eyebrowRole}</span>
      <span class="identity-eyebrow-sep" aria-hidden="true"> · </span>
      <span class="identity-eyebrow-location">{site.location}</span>
    </span>
  </p>

  <h1 class="identity-name" id="identity-title">
    {site.name}<span class="dot">.</span>
  </h1>

  <p class="identity-headline">{hero.headline}</p>
  <p class="identity-lead">{hero.lead}</p>

  <p class="identity-currently">
    <strong>Currently</strong>
    {hero.currently}
  </p>

  <VisitorStats />
</section>

<style>
  /*
    Simple mode is the readable page, so the identity becomes its opening:
    same container as the rest of the page, full display sizes. The world-mode
    rules below override all of this into a corner caption.
  */
  .world-identity {
    width: 100%;
    max-width: var(--wrap);
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5.5rem) var(--gutter) clamp(1.2rem, 2.6vw, 2.2rem);
  }

  .identity-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.55rem;
  }

  .identity-eyebrow .mono {
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .identity-eyebrow-line {
    line-height: 1.35;
  }

  .identity-name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 8, 'WONK' 1;
    font-size: var(--step-5);
    font-weight: 620;
    line-height: 1;
    letter-spacing: -0.028em;
  }

  .identity-name .dot {
    color: var(--accent);
  }

  .identity-headline {
    margin: 0 0 0.9rem;
    font-size: var(--step-3);
    line-height: 1.28;
    letter-spacing: -0.012em;
    font-weight: 450;
    color: var(--text-soft);
    text-wrap: balance;
  }

  .identity-lead {
    margin: 0 0 1rem;
    max-width: 52ch;
    color: var(--muted);
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .identity-currently {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .identity-currently strong {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    margin-right: 0.4rem;
  }

  /*
    While the world is running this is a caption in the corner: it must not
    read as navigation and must not swallow a drag, so it ignores the pointer
    entirely. In simple mode the same markup is the opening of the page.

    The card also carries a soft scrim of its own. The island is wide, so the
    two can meet on a desktop; a gradient that fades out toward the top and the
    right keeps the words legible where they touch the scenery without drawing
    a visible panel across the picture — which is what a filled card would do.
  */
  :global(
    html[data-mode='world']:is(
        [data-world-state='idle'],
        [data-world-state='loading'],
        [data-world-state='recovering'],
        [data-world-hold='true']
      )
  )
    .world-identity {
    display: none;
  }

  :global(html[data-mode='world']) .world-identity {
    position: fixed;
    left: clamp(1rem, 2.5vw, 2.2rem);
    top: 50%;
    bottom: auto;
    z-index: 20;
    width: min(24rem, 26vw);
    max-width: none;
    margin: 0;
    padding: 0 clamp(0.2rem, 1vw, 0.6rem) 0 0;
    pointer-events: auto;
    transform: translateY(-50%);
  }

  :global(html[data-mode='world']) .world-identity::before,
  :global(html[data-mode='world']) .world-identity::after {
    content: '';
    position: absolute;
    inset: -2.5rem -4rem -2.5rem -2.5rem;
    z-index: -1;
    pointer-events: none;
  }

  :global(html[data-mode='world']) .world-identity::before {
    background: radial-gradient(
      120% 90% at 0% 50%,
      color-mix(in srgb, var(--ivory) 86%, transparent) 0%,
      color-mix(in srgb, var(--ivory) 52%, transparent) 48%,
      transparent 82%
    );
  }

  /*
    The night wash sits on top of the day wash and fades with the island.
    Swapping the gradient itself cannot animate, so it used to go dark in one
    step while the campus was still catching up.
  */
  :global(html[data-mode='world']) .world-identity::after {
    opacity: 1;
    transition: opacity var(--theme-fade) var(--theme-ease);
    background: radial-gradient(
      130% 100% at 0% 42%,
      color-mix(in srgb, var(--ink) 90%, transparent) 0%,
      color-mix(in srgb, var(--ink) 68%, transparent) 46%,
      transparent 80%
    );
  }

  :global(html[data-mode='world'][data-theme='light']) .world-identity::after {
    opacity: 0;
  }

  :global(html[data-mode='world']) .identity-name,
  :global(html[data-mode='world']) .identity-headline,
  :global(html[data-mode='world']) .identity-lead,
  :global(html[data-mode='world']) .identity-currently,
  :global(html[data-mode='world']) .identity-eyebrow .mono,
  :global(html[data-mode='world']) .identity-currently strong {
    transition: color var(--caption-fade) var(--theme-ease);
  }

  :global(html[data-mode='world']:not([data-theme='light'])) .world-identity {
    color: var(--caption);
  }

  :global(html[data-mode='world']:not([data-theme='light'])) .identity-name {
    color: var(--caption);
  }

  :global(html[data-mode='world']:not([data-theme='light'])) .identity-headline {
    color: var(--caption-soft);
  }

  :global(html[data-mode='world']:not([data-theme='light'])) .identity-lead,
  :global(html[data-mode='world']:not([data-theme='light'])) .identity-currently {
    color: var(--caption-muted);
  }

  :global(html[data-mode='world']:not([data-theme='light'])) .identity-eyebrow .mono {
    color: var(--teal);
  }

  :global(html[data-mode='world']:not([data-theme='light'])) .identity-currently strong {
    color: var(--amber);
  }

  :global(html[data-mode='world']) .identity-lead {
    font-size: 0.84rem;
    max-width: 38ch;
  }

  :global(html[data-mode='world']) .identity-name {
    font-size: clamp(1.35rem, 1.8vw, 1.75rem);
  }

  :global(html[data-mode='world']) .identity-headline {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
  }

  /* Phones: keep it, but clear of the control bar above and the sheet below. */
  @media (max-width: 860px) {
    :global(html[data-mode='world']) .world-identity {
      left: calc(0.9rem + env(safe-area-inset-left, 0px));
      right: auto;
      bottom: auto;
      top: calc(5.65rem + env(safe-area-inset-top, 0px));
      width: min(11.5rem, calc(100vw - 13rem - env(safe-area-inset-left, 0px)));
      max-width: none;
      box-sizing: border-box;
      padding-right: 0;
      transform: none;
      text-align: left;
      z-index: 25;
    }

    :global(html[data-mode='world'][data-sound-panel='open']) .world-identity {
      top: calc(11.5rem + env(safe-area-inset-top, 0px));
      width: min(13rem, calc(100vw - 1.8rem - env(safe-area-inset-left, 0px)));
    }

    :global(html[data-mode='world']) .identity-eyebrow {
      align-items: center;
    }

    :global(html[data-mode='world']) .identity-eyebrow-line {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.15rem 0.35rem;
      white-space: normal;
      text-wrap: balance;
    }

    :global(html[data-mode='world']) .identity-eyebrow-sep,
    :global(html[data-mode='world']) .identity-eyebrow-location {
      display: none;
    }

    :global(html[data-mode='world']) .identity-lead,
    :global(html[data-mode='world']) .identity-currently,
    :global(html[data-mode='world']) .identity-headline {
      display: none;
    }

    :global(html[data-mode='world']) .identity-name {
      font-size: clamp(1.15rem, 5.2vw, 1.35rem);
      line-height: 1.08;
      text-wrap: balance;
    }
  }

  @keyframes identity-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-mode='world']) .world-identity {
      animation: none;
    }
  }
</style>
