---
/**
 * The world's persistent chrome.
 *
 * `transition:persist` keeps this element — and one set of event handlers —
 * alive for the whole session, so the controls keep working across route
 * swaps without anything being re-initialised. It sits above the reading
 * surfaces, which is what makes the sun/moon switch and the map reachable
 * while the CV, an article or a case study is open.
 */
import Icon from '../Icon.astro';
import { DESTINATIONS, WORLD_NAV } from '../../lib/world/destinations';
import { GATHER_PROJECT_NAME, liveGithubProjects } from '../../data/github-projects';

const dockDestinations = DESTINATIONS.filter((destination) => destination.id !== 'workbench');
import { hero, rootUrl } from '../../site.config';

const currentPath = Astro.url.pathname;
const normalise = (href: string) => {
  const full = rootUrl(href);
  const trimmed = full.length > 1 ? full.replace(/\/+$/, '') : full;
  return trimmed === '' ? '/' : trimmed;
};
const isCurrent = (href: string) => {
  const target = normalise(href);
  const here = currentPath.length > 1 ? currentPath.replace(/\/+$/, '') : currentPath;
  return here === target;
};

/*
 * The caption icons.
 *
 * Rendered once as inert <template> elements and cloned by the world shell for
 * every caption it projects, so the world's captions and the pages draw their
 * icons from one component instead of two sets that drift apart.
 */
const captionIcons = [
  'compass',
  'document',
  'grid',
  'graph',
  'github',
  'mail',
  'user',
  'sun',
  'moon',
  'rss',
  'switch',
] as const;
---

<div class="world-icon-bank" data-world-icon-bank aria-hidden="true" hidden>
  {
    captionIcons.map((name) => (
      <template data-world-icon={name}>
        <Icon name={name} size={14} />
      </template>
    ))
  }
</div>

<div class="world-chrome" data-world-chrome transition:persist="world-chrome">
  <h2 class="visually-hidden">World controls</h2>

  <div class="world-chrome-bar">
    <div class="world-chrome-actions">
      {
        liveGithubProjects.map((build, index) => (
          <div class="world-live-wrap">
            <a
              class="world-control world-control--icon world-control--live"
              href={build.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-world-live
              data-live-pulse="true"
              data-world-live-name={build.name}
              data-track-gather={build.name === GATHER_PROJECT_NAME ? '' : undefined}
              data-track-gather-source={build.name === GATHER_PROJECT_NAME ? 'chrome_mic' : undefined}
              aria-label={`${build.name} — open live meeting transcriber in a new tab`}
            >
              <Icon name="mic" size={16} />
            </a>
            {
              index === 0 && (
                <p class="world-live-tip" data-world-live-tip role="status" hidden>
                  <span class="world-live-tip-text">
                    Try <strong>{build.name}</strong> — tap the mic for the live transcriber
                  </span>
                </p>
              )
            }
          </div>
        ))
      }

      <button
        class="world-control world-control--map"
        type="button"
        data-world-map
        aria-expanded="false"
        aria-controls="world-map-menu"
      >
        <Icon name="grid" size={15} />
        <span class="world-control-label">All pages</span>
      </button>

      {/*
        Reset view. A visitor who has dragged the campus out of frame needs one
        obvious way back, and double-clicking the background is not a control
        anybody can see.
      */}
      <button
        class="world-control world-control--icon"
        type="button"
        data-world-reset
        aria-label="Reset the view"
        title="Reset the view"
      >
        <Icon name="reset" size={15} />
      </button>

      {/*
        Sound. Mute, unmute and the volume slider live together in one popover
        so that the controls are always available without the bar becoming a
        mixing desk — and so they work identically while a document is open.

        The button itself is the icon alone: like the sun, its state is a
        picture rather than a word, and the accessible name carries the meaning
        for anyone who cannot see which of the two icons is showing.
      */}
      <div class="world-sound" data-world-sound>
        <button
          class="world-control world-control--icon world-control--sound"
          type="button"
          data-world-sound-toggle
          aria-expanded="false"
          aria-controls="world-sound-panel"
          aria-pressed="false"
          aria-label="Sound — off"
          title="Sound"
        >
          <span class="world-control-icon" aria-hidden="true">
            <span class="sound-icon sound-icon--off"><Icon name="sound-off" size={15} /></span>
            <span class="sound-icon sound-icon--on"><Icon name="sound-on" size={15} /></span>
          </span>
          <span class="visually-hidden" data-sound-label>Sound off</span>
        </button>

        <div
          class="world-sound-panel"
          id="world-sound-panel"
          data-world-sound-panel
          hidden
        >
          <p class="world-sound-title mono">Ambient score</p>
          <button
            class="world-sound-mute"
            type="button"
            data-world-sound-mute
            aria-pressed="false"
          >
            <span class="sound-icon sound-icon--off" aria-hidden="true"><Icon name="sound-off" size={16} /></span>
            <span class="sound-icon sound-icon--on" aria-hidden="true"><Icon name="sound-on" size={16} /></span>
            <span data-sound-mute-label>Play</span>
          </button>
          <label class="world-sound-volume">
            <span class="mono">
              <Icon name="volume" size={13} />
              Volume
            </span>
            <input
              type="range"
              min="0"
              max="100"
              step="1"
              value="30"
              data-world-volume
              aria-label="Music volume"
            />
          </label>
          <label class="world-sound-effects">
            <input type="checkbox" data-world-effects checked />
            <span>Interface sounds</span>
          </label>
          <p class="world-sound-note" data-sound-note>
            Generated in your browser — no track is downloaded.
          </p>
        </div>
      </div>
    </div>
  </div>

  <nav
    class="world-map"
    id="world-map-menu"
    data-world-map-menu
    hidden
    tabindex="-1"
    aria-label="Destinations"
  >
    <p class="world-map-title">
      <span class="mono">Campus map</span>
    </p>
    {
      liveGithubProjects.length > 0 && (
        <div class="world-map-live">
          <p class="world-map-live-title mono">Live builds</p>
          <ul class="world-map-live-list">
            {liveGithubProjects.map((build) => (
              <li>
                <a
                  class="world-map-live-link"
                  href={build.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-gather={build.name === GATHER_PROJECT_NAME ? '' : undefined}
                  data-track-gather-source={
                    build.name === GATHER_PROJECT_NAME ? 'chrome_map_live' : undefined
                  }
                >
                  <span class="world-map-label">{build.name}</span>
                  <span class="world-map-detail">Open live app</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ul>
      {
        WORLD_NAV.map((entry) => (
          <li>
            <a
              class="world-map-link"
              href={rootUrl(entry.href)}
              data-world-dest={entry.id}
              aria-current={isCurrent(entry.href) ? 'page' : undefined}
            >
              <span class="world-map-label">{entry.label}</span>
              <span class="world-map-detail">{entry.detail}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {/*
      The ambient-motion control lives here rather than in the bar: the bar
      carries only what a visitor reaches for constantly (map, home, light),
      and pausing the world is something you set once.
    */}
    <div class="world-map-settings">
      {/*
        The hour.
        
        The world's light comes from the visitor's own clock, which is the honest
        default but a poor demonstration: nobody can see the golden hour at four
        in the afternoon. This is the one control that makes the sky legible as a
        *system* rather than as a picture — drag it to any hour of the day, and
        the sun, the moon, the stars, the shadows and the colour of the air all
        follow, because that is what they are functions of.
        
        It is deliberately a dial and not a selection of presets: the whole point
        is that the sky is continuous, and four buttons would hide the thing that
        makes it worth having.
      */}
      <div class="world-map-setting world-map-setting--time">
        <label class="world-time-label" for="world-sky-hour">
          <span class="world-map-setting-text">
            <span class="world-map-setting-label">Time of day</span>
            <span class="world-map-setting-state" data-world-sky-state>Following your clock</span>
          </span>
        </label>
        <input
          class="world-time-range"
          id="world-sky-hour"
          type="range"
          min="0"
          max="1439"
          step="5"
          value="720"
          data-world-sky-hour
          aria-label="Hour of the day"
          aria-describedby="world-sky-hint"
        />
        <button
          class="world-time-follow"
          type="button"
          data-world-sky-follow
          aria-pressed="true"
        >
          Follow your clock
        </button>
      </div>

      <button
        class="world-map-setting"
        type="button"
        data-world-ambient
        aria-pressed="false"
        aria-label="Pause ambient movement"
      >
        <span class="ambient-icon ambient-icon--pause" aria-hidden="true"><Icon name="pause" size={14} /></span>
        <span class="ambient-icon ambient-icon--play" aria-hidden="true"><Icon name="play" size={14} /></span>
        <span class="world-map-setting-text">
          <span class="world-map-setting-label">Ambient movement</span>
          <span class="world-map-setting-state" data-ambient-state>Moving</span>
        </span>
      </button>
    </div>

    <p class="world-map-hint" id="world-sky-hint">
      Selecting a place moves the camera there; selecting an object opens its
      document without leaving the world. Drag the time dial to see the sun,
      moon and stars at any hour.
    </p>
  </nav>

  <nav class="world-dock" aria-label="Campus navigation">
    {
      dockDestinations.map((destination) => (
        <button
          class="world-dock-item"
          type="button"
          data-world-dock={destination.id}
          aria-label={destination.name}
          title={destination.name}
          aria-current={destination.id === 'campus' && isCurrent('/') ? 'page' : undefined}
        >
          <span class="world-dock-icon" aria-hidden="true">
            <Icon name={destination.dockIcon} size={18} />
          </span>
          <span class="world-dock-label">{destination.label}</span>
        </button>
      ))
    }
    <button
      class="world-dock-item world-dock-item--more"
      type="button"
      data-world-dock="workbench"
      aria-label="Open source"
      title="Open source"
    >
      <span class="world-dock-icon" aria-hidden="true">
        <Icon name="github" size={18} />
      </span>
      <span class="world-dock-label">Open source</span>
    </button>
  </nav>

  <div class="world-sound-gate" data-world-sound-gate hidden>
    <div class="world-sound-gate-card">
      <p class="world-sound-gate-title">Enter the campus</p>
      <p class="world-sound-gate-lead">Ambient music is optional and stays off until you choose.</p>
      <div class="world-sound-gate-actions">
        <button class="btn btn--primary" type="button" data-world-enter-sound>Enter with sound</button>
        <button class="btn btn--ghost" type="button" data-world-enter-silent>Enter silently</button>
      </div>
    </div>
  </div>

  {/*
    The failure screen. It is deliberately not a fallback to a conventional
    portfolio: it says what happened, offers a retry, and keeps the world's
    own routes available.
  */}
  <div
    class="world-alert"
    data-world-alert
    hidden
    role="alertdialog"
    aria-labelledby="world-alert-title"
    aria-describedby="world-alert-body"
  >
    <div class="world-alert-card">
      <p class="world-alert-kicker mono">{hero.stage.errorLabel}</p>
      <h2 class="world-alert-title" id="world-alert-title">The world could not start</h2>
      <p class="world-alert-body" id="world-alert-body">
        This experience needs WebGL and the 3D module. Your browser, graphics
        driver or connection may have interrupted it.
        <span data-world-alert-reason></span>
      </p>
      <div class="world-alert-actions">
        <button class="btn btn--primary" type="button" data-world-retry>Try again</button>
        <a class="btn btn--ghost" href={Astro.url.pathname + Astro.url.search} data-world-reload>
          Reload the page
        </a>
        <button class="btn btn--ghost" type="button" data-world-dismiss>
          Read the documents without the 3D scene
        </button>
      </div>
      <p class="world-alert-foot">
        Nothing has been lost: this page, its URL and its content are intact.
        Everything the site contains — the CV, every article and case study,
        the repositories and the contact options — is ordinary readable HTML
        inside the world's own panels.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  /**
   * Plain DOM only, on purpose: this is the one piece of the interface that
   * has to work when a module fails to download. It installs the bridge the
   * world reports through, the retry, and a watchdog that refuses to leave an
   * indefinite loading screen behind.
   */
  (function () {
    var alertBox = document.querySelector('[data-world-alert]');
    var reason = document.querySelector('[data-world-alert-reason]');
    var retry = document.querySelector('[data-world-retry]');
    var retrying = false;

    function worldRoot() {
      return document.querySelector('[data-world]');
    }

    /*
     * The state lives on two elements: `[data-world]`, which the shell works
     * from, and the document element, which the interface is styled from —
     * including the loading experience, which owns the screen until the campus
     * is there. This script is the plain-DOM path, so it keeps both in step by
     * hand; the shell does the same through `mirrorWorldState`.
     */
    function setState(state) {
      var world = worldRoot();
      if (world) world.setAttribute('data-world-state', state);
      var html = document.documentElement;
      html.dataset.worldState = state;
      if (state === 'ready' || state === 'degraded' || state === 'error') {
        html.dataset.worldReady = 'true';
      } else {
        delete html.dataset.worldReady;
      }
    }

    function show(message) {
      var world = worldRoot();
      if (world && world.getAttribute('data-world-state') === 'ready') return;
      /* Already answered once: the visitor chose to read without the scene.
         The key is written by the dismiss handler below; chrome.ts reads it
         through the same name. */
      try {
        if (window.sessionStorage.getItem('world:no-scene') === '1') return;
      } catch (error) {
        /* storage unavailable — the in-page state still stands */
      }
      if (world && world.getAttribute('data-world-state') === 'degraded') return;
      setState('error');
      if (reason && message) reason.textContent = ' ' + message;
      if (alertBox) alertBox.hidden = false;
      if (retry && alertBox && !alertBox.contains(document.activeElement)) {
        var active = document.activeElement;
        if (!active || active === document.body) retry.focus();
      }
    }

    function hide() {
      if (alertBox) alertBox.hidden = true;
      if (reason) reason.textContent = '';
      retrying = false;
      if (retry) {
        retry.disabled = false;
        retry.textContent = 'Try again';
      }
    }

    show.hide = hide;
    window.__worldAlert = show;

    if (retry) {
      retry.addEventListener('click', function () {
        if (retrying) return;
        /* Asking to try again is asking for the world back. */
        try {
          window.sessionStorage.removeItem('world:no-scene');
        } catch (error) {
          /* storage unavailable */
        }
        retrying = true;
        retry.disabled = true;
        retry.textContent = 'Trying again…';
        if (reason) {
          reason.textContent = ' Rebuilding the world — this can take a moment.';
        }
        document.dispatchEvent(new CustomEvent('world:retry'));
        window.setTimeout(function () {
          if (!retrying) return;
          var world = worldRoot();
          var state = world ? world.getAttribute('data-world-state') : 'missing';
          if (state === 'ready' || state === 'loading' || state === 'recovering') return;
          retrying = false;
          retry.disabled = false;
          retry.textContent = 'Try again';
          if (reason) {
            reason.textContent =
              ' The 3D module still cannot be loaded. Reloading the page is the honest next step.';
          }
        }, 4500);
      });
    }

    var world = worldRoot();
    if (world) {
      var hideWhenReady = new MutationObserver(function () {
        if (world.getAttribute('data-world-state') === 'ready') hide();
      });
      hideWhenReady.observe(world, { attributes: true, attributeFilter: ['data-world-state'] });
    }

    /*
     * Phones often need twenty-plus seconds for the first 3D build; an early
     * watchdog looked like "the world cannot load" even when it was still working.
     */
    var coarse =
      window.matchMedia && window.matchMedia('(max-width: 860px) and (pointer: coarse)').matches;
    var loadBudgetMs = coarse ? 32000 : 12000;
    window.setTimeout(function () {
      var root = worldRoot();
      if (!root) return;
      var state = root.getAttribute('data-world-state');
      if (state === 'ready' || state === 'error' || state === 'recovering' || state === 'degraded') {
        return;
      }
      show(
        'The interactive world did not finish starting. This is usually a slow or interrupted download of the 3D module.'
      );
    }, loadBudgetMs);

    /* Reading without the scene is an explicit choice, made here and never
       made for the visitor: the world is not silently replaced by a
       conventional portfolio. */
    var dismiss = document.querySelector('[data-world-dismiss]');
    if (dismiss) {
      dismiss.addEventListener('click', function () {
        setState('degraded');
        try {
          window.sessionStorage.setItem('world:no-scene', '1');
        } catch (error) {
          /* storage unavailable — the choice lasts for this page only */
        }
        hide();
        var close = document.querySelector('[data-surface-close]');
        if (close) close.focus();
      });
    }
  })();
</script>

<script>
  /**
   * The interface module. Processed (not inline) so its import is bundled;
   * the plain-DOM fallback above is what covers the case where even this
   * cannot load.
   */
  import { bootstrapChrome } from '../../lib/world/chrome';
  import { watchSoundControls } from '../../lib/world/sound-controls';
  const start = () => {
    try {
      bootstrapChrome();
      watchSoundControls();
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      window.__worldAlert?.(`The world controls could not be started (${message}).`);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>

<style>
  .world-chrome {
    position: fixed;
    inset: 0;
    z-index: 60;
    isolation: isolate;
    pointer-events: none;
    display: none;
  }

  :global(html[data-mode='world']) .world-chrome {
    display: block;
  }

  .world-icon-bank {
    display: none !important;
  }

  .world-chrome-bar,
  .world-map,
  .world-alert-card {
    pointer-events: auto;
  }

  /* The bar keeps clear of the reading surface: it takes the opposite side. */
  .world-chrome-bar {
    position: absolute;
    top: calc(0.85rem + env(safe-area-inset-top, 0px));
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 861px) {
    .world-chrome-bar {
      right: calc(0.85rem + env(safe-area-inset-right, 0px));
      left: auto;
      justify-content: flex-end;
      transition: left var(--dur-3) var(--ease-out), right var(--dur-3) var(--ease-out);
    }

    :global(html[data-mode='world'] body[data-panel='left'][data-surface]:not([data-surface='none'])) .world-chrome-bar {
      right: calc(0.85rem + env(safe-area-inset-right, 0px));
      left: auto;
    }
  }

  .world-chrome-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    overflow: visible;
  }

  /* 44px targets everywhere, by touch or by mouse. */
  .world-control {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.7rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    background: var(--bg-raised);
    box-shadow: var(--shadow-1);
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .world-control:hover,
  .world-control:focus-visible {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .world-live-wrap {
    position: relative;
    display: inline-flex;
    overflow: visible;
  }

  .world-control--live {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 40%, var(--hairline-strong));
    text-decoration: none;
    width: 44px;
    padding: 0;
    animation: world-live-blink 1.05s ease-in-out infinite;
  }

  .world-control--live :global(svg) {
    animation: world-live-icon-pulse 1.05s ease-in-out infinite;
  }

  .world-control--live:hover,
  .world-control--live:focus-visible {
    color: var(--text);
    border-color: var(--signal-line);
    background: var(--signal-soft);
  }

  @keyframes world-live-blink {
    0%,
    100% {
      border-color: color-mix(in srgb, var(--signal) 30%, var(--hairline-strong));
      box-shadow: var(--shadow-1);
      transform: scale(1);
      filter: brightness(1);
    }
    50% {
      border-color: var(--signal);
      box-shadow:
        0 0 0 4px var(--signal-soft),
        0 0 22px color-mix(in srgb, var(--signal) 70%, transparent);
      transform: scale(1.1);
      filter: brightness(1.15);
    }
  }

  @keyframes world-live-icon-pulse {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 1;
    }
  }

  .world-live-tip {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 200;
    width: max-content;
    max-width: min(16rem, 72vw);
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--signal-line);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    box-shadow: var(--shadow-2);
    color: var(--text-soft);
    font-size: 0.78rem;
    line-height: 1.45;
    pointer-events: none;
    opacity: 0;
  }

  .world-live-tip.world-live-tip--open {
    animation: world-live-tip-in 480ms var(--ease-out) both, world-live-tip-float 2.6s ease-in-out 0.5s infinite;
  }

  .world-live-tip::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 14px;
    width: 10px;
    height: 10px;
    border-top: 1px solid var(--signal-line);
    border-left: 1px solid var(--signal-line);
    background: var(--bg-raised);
    transform: rotate(45deg);
  }

  .world-live-tip strong {
    color: var(--signal);
    font-weight: 600;
  }

  .world-live-tip[hidden] {
    display: none;
  }

  @keyframes world-live-tip-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes world-live-tip-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .world-control--live,
    .world-control--live :global(svg) {
      animation: none;
    }

    .world-control--live {
      outline: 2px solid var(--signal-line);
      outline-offset: 2px;
    }

    .world-live-tip.world-live-tip--open {
      animation: world-live-tip-in 200ms var(--ease-out) both;
    }

  }

  .world-control--icon {
    padding: 0;
  }

  /* The sound control is its icon alone, at every width. */
  .world-control--sound {
    padding: 0;
    width: 44px;
  }

  /* ── The light control ────────────────────────────────────────────── */

  .world-control--light {
    padding: 0;
    width: 44px;
  }

  .world-control--light[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  /*
    The two faces of the switch, cross-faded. The moon is what the world shows
    when it is dark and the sun what it shows when it is light, so the control
    always pictures the light the visitor is looking at — and a press is always
    a move to the other one.
  */
  .light-icon {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .light-icon--sun {
    opacity: 0;
    transform: rotate(-40deg) scale(0.7);
  }

  :global(html[data-theme='light']) .light-icon--moon {
    opacity: 0;
    transform: rotate(40deg) scale(0.7);
  }

  :global(html[data-theme='light']) .light-icon--sun {
    opacity: 1;
    transform: none;
  }

  .world-control[aria-expanded='true'] {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  /* ── The labelled light control ───────────────────────────────────── */

  /*
    The sun/moon icon and the word beside it. The icon sits in its own slot so
    the two faces can be cross-faded without either of them intercepting the
    other, and the word is what makes the control self-describing.
  */
  .world-control-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  /*
    The icon slots in a control are stacked and cross-faded. They must not
    intercept anything: a decorative span that covers a sibling control is
    exactly how a button ends up looking functional while doing nothing.
  */
  .ambient-icon,
  .sound-icon {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .ambient-icon--play,
  .sound-icon--on {
    opacity: 0;
    transform: rotate(-40deg) scale(0.7);
  }

  /* ── Sound ────────────────────────────────────────────────────────── */

  .world-sound {
    position: relative;
    display: inline-flex;
  }

  .world-control--sound[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  [data-world-sound-toggle][aria-pressed='true'] .sound-icon--off {
    opacity: 0;
    transform: scale(0.7);
  }

  [data-world-sound-toggle][aria-pressed='true'] .sound-icon--on {
    opacity: 1;
    transform: none;
  }

  .world-sound-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(17.5rem, calc(100vw - 1.6rem));
    padding: 0.85rem 0.9rem 0.9rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-2);
    animation: world-map-in var(--dur-3) var(--ease-out) both;
  }

  .world-sound-panel[hidden] {
    display: none;
  }

  .world-sound-title {
    margin: 0 0 0.6rem;
    color: var(--faint);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .world-sound-mute {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: var(--chip-bg);
    color: var(--text-soft);
    font-size: 0.86rem;
    font-weight: 500;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }

  .world-sound-mute:hover,
  .world-sound-mute:focus-visible {
    color: var(--accent);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .world-sound-mute .sound-icon {
    position: relative;
    inset: auto;
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }

  .world-sound-mute[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  .world-sound-mute[aria-pressed='true'] .sound-icon--off {
    opacity: 0;
    transform: scale(0.7);
  }

  .world-sound-mute[aria-pressed='true'] .sound-icon--on {
    opacity: 1;
    transform: none;
  }

  .world-sound-volume {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }

  .world-sound-volume .mono {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--faint);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .world-sound-volume input[type='range'] {
    width: 100%;
    height: 28px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .world-sound-volume input[type='range']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 999px;
  }

  /*
    Interface sounds: a plain checkbox rather than a switch, because it is a
    setting rather than a control the visitor works while looking at the world.
  */
  .world-sound-effects {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.35rem;
    padding: 0 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .world-sound-effects:hover,
  .world-sound-effects:focus-within {
    background: var(--accent-soft);
  }

  .world-sound-effects input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .world-sound-effects input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .world-sound-note {
    margin: 0.7rem 0 0;
    color: var(--faint);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .world-sound-note[data-state='blocked'] {
    color: var(--signal);
  }

  [data-world-ambient][aria-pressed='true'] .ambient-icon--pause {
    opacity: 0;
    transform: scale(0.7);
  }

  [data-world-ambient][aria-pressed='true'] .ambient-icon--play {
    opacity: 1;
    transform: none;
  }

  /* ── The destination menu ─────────────────────────────────────────── */

  .world-map {
    position: absolute;
    top: calc(4.3rem + env(safe-area-inset-top, 0px));
    left: calc(0.85rem + env(safe-area-inset-left, 0px));
    width: min(23rem, calc(100vw - 1.7rem));
    /*
      Every destination, not a slice of them. The panel is measured against the
      room the viewport actually has below the bar rather than against a
      fraction of it, so the whole menu is on screen at once; the scroll
      survives only as the last resort for a window too short for the list.
    */
    max-height: calc(100vh - 5.3rem - env(safe-area-inset-top, 0px));
    /* The dynamic viewport follows a phone's browser chrome as it comes and
       goes, so the panel never ends below the edge the visitor can see. */
    max-height: calc(100dvh - 5.3rem - env(safe-area-inset-top, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.9rem 0.95rem 1rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-2);
  }

  .world-map[hidden] {
    display: none !important;
  }

  .world-map:not(.is-open) {
    visibility: hidden;
    pointer-events: none;
  }

  .world-map.is-opening {
    visibility: visible;
    opacity: 0;
  }

  .world-map.is-open {
    visibility: visible;
    opacity: 1;
  }

  @media (min-width: 861px) {
    :global(html[data-mode='world'] body[data-panel='left'][data-surface]:not([data-surface='none'])) .world-map {
      left: auto;
      right: calc(0.85rem + env(safe-area-inset-right, 0px));
    }
  }

  @keyframes world-map-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .world-map-live {
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }

  .world-map-live-title {
    margin: 0 0 0.55rem;
    color: var(--signal);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .world-map-live-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .world-map-live-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .world-map-live-link:hover,
  .world-map-live-link:focus-visible {
    background: var(--signal-soft);
    border-color: var(--signal-line);
  }

  .world-map-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.7rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--hairline);
    color: var(--faint);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .world-map ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .world-map-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .world-map-link:hover,
  .world-map-link:focus-visible {
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .world-map-link[aria-current='page'] {
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .world-map-label {
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 520;
  }

  .world-map-detail {
    color: var(--faint);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .world-map-hint {
    margin: 0.85rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--hairline);
    color: var(--faint);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  /* ── Map settings row ─────────────────────────────────────────────── */

  .world-map-settings {
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--hairline);
  }

  .world-map-setting {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-soft);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .world-map-setting:hover,
  .world-map-setting:focus-visible {
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .world-map-setting .ambient-icon {
    position: relative;
    inset: auto;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: var(--accent);
  }

  .world-map-setting .ambient-icon--play {
    position: absolute;
  }

  .world-map-setting-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
  }

  .world-map-setting-label {
    font-size: 0.88rem;
    font-weight: 500;
  }

  .world-map-setting-state {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .world-map-setting[aria-pressed='true'] .world-map-setting-state {
    color: var(--signal);
  }

  /*
    The time dial.

    Styled as a rule with a handle rather than as a browser slider, because the
    thing it represents is a *day*: the track is the twenty-four hours and the
    handle is the moment. The default control would read as a form field.
  */
  .world-map-setting--time {
    display: block;
    cursor: default;
    padding-bottom: 0.6rem;
  }

  .world-time-label {
    display: block;
    cursor: default;
  }

  .world-time-range {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    height: 28px;
    margin: 0.35rem 0 0;
    background: transparent;
    cursor: pointer;
  }

  .world-time-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      #0a1024 0%,
      #16233f 18%,
      #ff9a52 26%,
      #bcd6ef 42%,
      #bcd6ef 62%,
      #ff8a44 76%,
      #16233f 86%,
      #0a1024 100%
    );
  }

  .world-time-range::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      #0a1024 0%,
      #16233f 18%,
      #ff9a52 26%,
      #bcd6ef 42%,
      #bcd6ef 62%,
      #ff8a44 76%,
      #16233f 86%,
      #0a1024 100%
    );
  }

  .world-time-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-line);
  }

  .world-time-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--accent);
  }

  .world-time-range:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .world-time-follow {
    margin-top: 0.35rem;
    padding: 0.3rem 0.55rem;
    min-height: 32px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .world-time-follow:hover,
  .world-time-follow:focus-visible {
    background: var(--accent-soft);
  }

  .world-time-follow[aria-pressed='true'] {
    color: var(--signal);
    border-color: var(--accent-line);
  }

  /* ── The failure screen ───────────────────────────────────────────── */

  .world-alert {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    pointer-events: auto;
  }

  .world-alert[hidden] {
    display: none;
  }

  .world-alert-card {
    width: min(32rem, 100%);
    max-height: 86vh;
    overflow-y: auto;
    padding: clamp(1.4rem, 4vw, 2.2rem);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-2);
    animation: world-map-in var(--dur-3) var(--ease-out) both;
  }

  .world-alert-kicker {
    margin: 0 0 0.6rem;
    color: var(--danger);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .world-alert-title {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 8, 'WONK' 1;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .world-alert-body {
    margin: 0 0 1.2rem;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .world-alert-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .world-alert-foot {
    margin: 1rem 0 0;
    color: var(--faint);
    font-size: 0.8rem;
  }

  /* ── Phones ───────────────────────────────────────────────────────── */

  @media (max-width: 860px) {
    :global(html[data-mode='world'] .world-chrome-bar) {
      left: 50%;
      right: auto;
      top: calc(0.55rem + env(safe-area-inset-top, 0px));
      width: max-content;
      max-width: calc(100vw - 1.2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px));
      justify-content: center;
      transform: translateX(-50%);
      transition: none;
    }

    :global(
        html[data-mode='world']
          body[data-panel='left'][data-surface]:not([data-surface='none'])
          .world-chrome-bar
      ) {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
    }

    .world-chrome-actions {
      flex-wrap: nowrap;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.22rem 0.4rem;
      border: 1px solid var(--hairline-strong);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
      box-shadow: var(--shadow-1);
      backdrop-filter: blur(12px);
    }

    .world-chrome-actions .world-control {
      box-sizing: border-box;
      width: 44px;
      height: 44px;
      min-width: 44px;
      max-width: 44px;
      padding: 0;
      border-radius: 50%;
      box-shadow: none;
      border-color: color-mix(in srgb, var(--hairline-strong) 70%, transparent);
      background: transparent;
      -webkit-tap-highlight-color: transparent;
    }

    .world-chrome-actions .world-control-label {
      display: none;
    }

    .world-chrome-actions .world-control:hover,
    .world-chrome-actions .world-control:focus-visible,
    .world-chrome-actions .world-control:active {
      border-radius: 50%;
    }

    .world-chrome-actions .world-control--map {
      padding: 0;
    }

    .world-live-tip {
      display: none !important;
    }

    .world-map {
      left: calc(0.6rem + env(safe-area-inset-left, 0px));
      right: calc(0.6rem + env(safe-area-inset-right, 0px));
      width: auto;
      top: calc(5.15rem + env(safe-area-inset-top, 0px));
      max-height: calc(100vh - 6.2rem - env(safe-area-inset-top, 0px));
      max-height: calc(100dvh - 6.2rem - env(safe-area-inset-top, 0px));
    }

    :global(html[data-mode='world'] body[data-panel='left'][data-surface]:not([data-surface='none'])) .world-map {
      left: calc(0.6rem + env(safe-area-inset-left, 0px));
      right: calc(0.6rem + env(safe-area-inset-right, 0px));
    }

    /*
      The bar is centered; anchoring the panel to the sound button (especially
      with translateX(-50%)) shoves it off the right edge. Pin it under the bar
      inside the safe area instead.
    */
    .world-sound-panel {
      position: fixed;
      top: calc(3.85rem + env(safe-area-inset-top, 0px));
      right: calc(0.75rem + env(safe-area-inset-right, 0px));
      left: auto;
      width: min(19rem, calc(100vw - 1.5rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
      max-width: none;
      transform: none;
      z-index: 210;
    }
  }

  @media (max-width: 560px) {
    /*
      On a phone the words go and the icons stay: the bar has three controls
      plus the readout in one strip, and a label is what would push one of them
      off the edge. Every control keeps its 44px target and its accessible
      name.
    */
    .world-control-text {
      display: none;
    }

    .world-control-icon {
      width: 18px;
      height: 18px;
    }
  }

  @media (max-width: 420px) {
    .world-control-label {
      display: none;
    }

    .world-control--map {
      padding: 0 0.75rem;
    }
  }

  /*
    A window that is short rather than narrow — a laptop with a shallow
    viewport, or a phone held sideways — tightens the list instead of cutting
    it off. Only the padding and the secondary line give way: every row keeps
    its 44px target.
  */
  @media (max-height: 720px) {
    .world-map {
      padding: 0.7rem 0.8rem 0.8rem;
    }

    .world-map-title {
      margin-bottom: 0.5rem;
      padding-bottom: 0.45rem;
    }

    .world-map-link {
      padding: 0.35rem 0.55rem;
    }

    .world-map-detail {
      font-size: 0.72rem;
    }

    .world-map-settings {
