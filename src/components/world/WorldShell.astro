---
/**
 * The persistent world shell.
 *
 * `transition:persist` keeps this element — and therefore the WebGL context,
 * the scene and the camera — alive across client-side navigation. Only the
 * reading surfaces around it are swapped.
 */
import { hero, rootUrl } from '../../site.config';

const portrait = rootUrl('/images/abd-bastola.jpg');
---

<div
  class="world"
  id="world"
  data-world
  data-world-state="loading"
  data-world-reading="false"
  data-portrait={portrait}
  transition:persist="world"
>
  <div class="world-stage" data-world-stage>
    {/*
      The loading experience.

      Not a poster and not an illustration of the finished thing: while the
      campus is being built the visitor watches the station's own orbital
      mechanism, turning, over the haze the first frame will open onto. The
      rule under it moves on real milestones only — the engine arriving, the
      scene being raised, the campus coming online — so it can never claim
      work that has not happened, and it is never left sitting at 100% waiting
      for a scene that failed.

      The element keeps its `world-poster` name because that is the layer the
      canvas cross-fades with when the world is ready.
    */}
    <div class="world-poster" data-world-poster>
      <div
        class="world-loader"
        data-world-loader
        data-step-engine={hero.stage.steps.engine}
        data-step-build={hero.stage.steps.build}
      >
        <div class="loader-sky" aria-hidden="true"></div>

        <div class="loader-stack">
          <div class="loader-orbit-frame" aria-hidden="true">
            <div class="loader-orbit">
              <span class="loader-ring loader-ring--equator"></span>
              <span class="loader-ring loader-ring--meridian"></span>
              <span class="loader-ring loader-ring--outer">
                <span class="loader-satellite"></span>
              </span>
              <span class="loader-core"></span>
            </div>
          </div>

          <div class="loader-copy">
            <p class="loader-title">{hero.stage.loadingLabel}</p>
            <p class="loader-step" data-world-load-step>{hero.stage.steps.engine}</p>

            <div
              class="loader-rule"
              data-world-progress
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              aria-label={hero.stage.loadingLabel}
            >
              <span class="loader-rule-fill" data-world-progress-fill></span>
              <span class="loader-rule-sheen" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <canvas
      class="world-canvas"
      data-world-canvas
      width="800"
      height="600"
      role="img"
      aria-label={`${hero.stage.posterAlt} Drag to look around, scroll to zoom, and select a caption to open that part of the site.`}
    >
    </canvas>

    <!-- Captions are created by the shell: projected each frame. -->
    <div class="world-hotspots" data-world-hotspots></div>

    <p
      class="world-status"
      data-world-status
      data-state="loading"
      data-message-ready={hero.stage.readyLabel}
      role="status"
      aria-live="polite"
    >
      <span class="pulse" aria-hidden="true"></span>
      <span data-world-status-text>{hero.stage.loadingLabel}</span>
    </p>
  </div>
</div>

<script>
  /**
   * Boot the world.
   *
   * The import is dynamic and gated on the capability the pre-paint probe
   * decided, so a visitor whose browser cannot render the world never
   * downloads three.js. Once loaded, the module stays resident and later
   * client-side navigations only re-apply state — the renderer is never
   * rebuilt.
   *
   * Every failure path ends in the branded alert with a Retry, raised through
   * the plain-DOM bridge the chrome installs, so even a module that fails to
   * download can be reported honestly instead of leaving a blank canvas.
   */
  import type { ProgressReport } from '../../lib/world/progress';

  const loader = document.querySelector<HTMLElement>('[data-world-loader]');
  const world = document.querySelector<HTMLElement>('[data-world]');
  const track = document.querySelector<HTMLElement>('[data-world-progress]');
  const stepEl = document.querySelector<HTMLElement>('[data-world-load-step]');
  /*
   * The step labels come from the markup, not from this script: a bundled
   * script is hoisted out of the page, so it has no frontmatter to read.
   */
  const STEP_ENGINE = loader?.dataset.stepEngine ?? '';
  const STEP_BUILD = loader?.dataset.stepBuild ?? '';

  /*
   * The rule, and what it is allowed to say.
   *
   * `shown` is what the visitor sees; `ceiling` is how far the current phase
   * may creep towards without having finished. While the engine is on the wire
   * the honest answer is "not yet", so the bar advances towards 46% and never
   * reaches it; only the module actually arriving moves it past. The same
   * applies to the build: the bar can hold a conversation during it, and only
   * the shell — which is the one thing that knows the scene is up — takes it
   * to 100.
   *
   * How long the screen is given is a separate matter, and it is what stops
   * the whole thing reading as a glitch. A warm cache builds the campus in a
   * few hundred milliseconds: without a floor, the visitor gets a dark flash
   * with a rule that snaps to 100% and vanishes. If the world is ready before
   * `MIN_VISIBLE_MS`, the handover waits for it, so the rule visibly completes
   * and the canvas then dissolves in. A slow load is never delayed by any of
   * it — the floor only ever applies to time the loader has already had.
   */
  const MIN_VISIBLE_MS = 720;
  const startedAt = performance.now();
  let shown = 0;
  let ceiling = 8;
  let handedOver = false;
  let creep = 0;

  const paint = () => {
    const rounded = Math.round(shown);
    loader?.style.setProperty('--load-progress', (Math.min(shown, 100) / 100).toFixed(4));
    if (track) track.setAttribute('aria-valuenow', String(rounded));
  };

  /**
   * Let the canvas take over.
   *
   * The poster and the canvas cross-fade exactly as they always did; the hold
   * attribute only decides *when* that starts.
   */
  const handOver = () => {
    if (handedOver) return;
    handedOver = true;
    window.clearInterval(creep);
    delete document.documentElement.dataset.worldHold;
  };

  /**
   * The campus is built: finish the rule, then hand the screen over.
   *
   * The remaining time is spent easing `shown` to 100% rather than assigning
   * it, so the last thing the visitor sees is the rule completing instead of a
   * jump — and the canvas is held back until it has.
   */
  const complete = () => {
    if (handedOver) return;
    const from = shown;
    const left = MIN_VISIBLE_MS - (performance.now() - startedAt);
    /*
     * Enough time left to be worth watching: hold the handover and finish the
     * rule in front of the visitor. Too little to be anything but a blink:
     * hand straight over rather than adding a delay nobody asked for, which is
     * the case on every genuinely slow load.
     */
    if (left < 220) {
      shown = 100;
      paint();
      handOver();
      return;
    }
    document.documentElement.dataset.worldHold = 'true';
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / left);
      shown = from + (100 - from) * (1 - Math.pow(1 - t, 3));
      paint();
      if (t < 1) window.requestAnimationFrame(step);
      else handOver();
    };
    window.requestAnimationFrame(step);
  };

  const report: ProgressReport = (value, label) => {
    /*
     * 100 is not a progress reading — it is the shell saying the campus is
     * built, and the completion above is the only thing allowed to say that.
     */
    if (value >= 100) {
      complete();
      return;
    }
    shown = Math.max(shown, value);
    ceiling = Math.max(ceiling, shown);
    if (label && stepEl) stepEl.textContent = label;
    paint();
  };

  (window as unknown as { __worldProgress?: ProgressReport }).__worldProgress = report;

  const worldState = () => world?.dataset.worldState ?? 'loading';

  /*
   * The creep. Everything else on this screen is animated on the compositor —
   * transforms and opacity only — so it keeps turning even while the main
   * thread is building the island, which is exactly when a main-thread timer
   * cannot fire.
   */
  const creepStep = () => {
    const state = worldState();
    if (state === 'ready') {
      complete();
      return;
    }
    if (state === 'idle' || state === 'loading' || state === 'recovering') {
      shown += (ceiling - shown) * 0.09;
      paint();
      return;
    }
    if (state === 'error' || state === 'degraded') {
      loader?.setAttribute('data-stalled', 'true');
      window.clearInterval(creep);
      delete document.documentElement.dataset.worldHold;
      return;
    }
  };

  const startCreep = () => {
    window.clearInterval(creep);
    creep = window.setInterval(creepStep, 110);
  };

  const initialState = world?.dataset.worldState ?? 'loading';
  if (initialState === 'ready' || initialState === 'degraded') {
    shown = 100;
    paint();
    handOver();
  } else {
    if (world) {
      world.dataset.worldState = 'loading';
      document.documentElement.dataset.worldState = 'loading';
      delete document.documentElement.dataset.worldReady;
    }
    startCreep();
    paint();
    report(4, STEP_ENGINE);
    ceiling = 46;
  }

  const nextFrame = () =>
    new Promise<void>((resolve) => window.requestAnimationFrame(() => resolve()));

  let shellLoaded = false;

  const boot = async () => {
    if (document.documentElement.dataset.mode === 'simple') return;
    try {
      const { bootstrapShell } = await import('../../lib/world/shell');
      shellLoaded = true;
      /*
       * The engine is here. Saying so is worth a frame of its own: without it
       * the bar would jump from 46 straight to whatever the finished world
       * reports, because the build blocks the main thread from the first line
       * of `bootstrapShell` to the last.
       */
      report(46, STEP_BUILD);
      ceiling = 92;
      await nextFrame();
      bootstrapShell();
      document.addEventListener('astro:page-load', () => bootstrapShell());
    } catch (error) {
      loader?.setAttribute('data-stalled', 'true');
      const message = error instanceof Error ? error.message : String(error);
      const alert = window.__worldAlert;
      if (typeof alert === 'function') {
        alert(`The 3D module could not be loaded (${message}).`);
      }
    }
  };

  /**
   * Start once the first paint is done and the browser is idle: fetching and
   * parsing ~600KB of three.js during the first paint is what would push the
   * largest text paint out, and the loading experience covers the wait.
   */
  const schedule = () => {
    const idle = window.requestIdleCallback?.bind(window);
    if (typeof idle === 'function') idle(() => void boot(), { timeout: 1200 });
    else window.setTimeout(() => void boot(), 200);
  };

  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });

  /* Retry re-enters boot only when the module itself never arrived; once it
     has, the shell owns the rebuild so the canvas is replaced properly. */
  document.addEventListener('world:retry', () => {
    loader?.removeAttribute('data-stalled');
    /* A second attempt gets a second loading screen, not the tail of the
       first one's progress. */
    handedOver = false;
    shown = Math.min(shown, 60);
    ceiling = 92;
    delete document.documentElement.dataset.worldHold;
    startCreep();
    if (shellLoaded) return;
    void boot();
  });
</script>

<script is:inline>
  window.__worldAlert = window.__worldAlert || function () {};

  /*
   * The document element carries the world's state as well as the world
   * element, so the interface can be styled from one attribute: the loading
   * experience owns the screen until the campus is there, and hands it back
   * when the visitor is reading without a scene or looking at the failure
   * screen.
   *
   * It reads the world element rather than assuming, because this runs again
   * on a client-side navigation — where the world element is the persisted
   * one and already knows what it is. Assuming "loading" there would take the
   * controls away from a world that was running perfectly well.
   */
  (function () {
    var world = document.querySelector('[data-world]');
    var state = (world && world.dataset.worldState) || 'idle';
    if (state === 'idle') state = 'loading';
    var usable = state === 'ready' || state === 'degraded' || state === 'error';
    if (usable) document.documentElement.dataset.worldReady = 'true';
    document.documentElement.dataset.worldState = state;
  })();
</script>
