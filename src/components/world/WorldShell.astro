---
/**
 * The persistent world shell.
 *
 * `transition:persist` keeps this element — and therefore the WebGL context,
 * the scene and the camera — alive across client-side navigation. Only the
 * reading surfaces around it are swapped.
 */
import StationPoster from '../observatory/StationPoster.astro';
import { hero, rootUrl } from '../../site.config';

const portrait = rootUrl('/images/abd-bastola.jpg');
---

<div
  class="world"
  id="world"
  data-world
  data-world-state="idle"
  data-world-reading="false"
  data-portrait={portrait}
  transition:persist="world"
>
  <div class="world-stage" data-world-stage>
    <div class="world-poster" data-world-poster>
      <StationPoster />
    </div>

    <canvas
      class="world-canvas"
      data-world-canvas
      width="800"
      height="600"
      role="img"
      aria-label={`${hero.stage.posterAlt} Drag to look around, scroll to zoom, and select a caption to open that part of the site.`}
    >
    </canvas>

    <!-- Captions are created by the shell: projected each frame. -->
    <div class="world-hotspots" data-world-hotspots></div>

    <p
      class="world-status"
      data-world-status
      data-state="loading"
      data-message-ready={hero.stage.readyLabel}
      role="status"
      aria-live="polite"
    >
      <span class="pulse" aria-hidden="true"></span>
      <span data-world-status-text>{hero.stage.loadingLabel}</span>
    </p>

    <p class="world-hint" data-world-hint hidden aria-hidden="true">
      <span class="world-hint-dot"></span>
      {hero.stage.hint}
    </p>
  </div>
</div>

<script>
  /**
   * Boot the world.
   *
   * The import is dynamic and gated on the capability the pre-paint probe
   * decided, so a visitor whose browser cannot render the world never
   * downloads three.js. Once loaded, the module stays resident and later
   * client-side navigations only re-apply state — the renderer is never
   * rebuilt.
   *
   * Every failure path ends in the branded alert with a Retry, raised through
   * the plain-DOM bridge the chrome installs, so even a module that fails to
   * download can be reported honestly instead of leaving a blank canvas.
   */
  let shellLoaded = false;

  const boot = async () => {
    if (document.documentElement.dataset.mode === 'simple') return;
    try {
      const { bootstrapShell } = await import('../../lib/world/shell');
      shellLoaded = true;
      bootstrapShell();
      document.addEventListener('astro:page-load', () => bootstrapShell());
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      const alert = window.__worldAlert;
      if (typeof alert === 'function') {
        alert(`The 3D module could not be loaded (${message}).`);
      }
    }
  };

  /**
   * Start once the first paint is done and the browser is idle. The world is
   * ~600KB of three.js; fetching and parsing it during the first paint pushed
   * the largest text paint past 2.5s, and the poster already covers the wait.
   */
  const schedule = () => {
    const idle = window.requestIdleCallback?.bind(window);
    if (typeof idle === 'function') idle(() => void boot(), { timeout: 1200 });
    else window.setTimeout(() => void boot(), 200);
  };

  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });

  /* Retry re-enters boot only when the module itself never arrived; once it
     has, the shell owns the rebuild so the canvas is replaced properly. */
  document.addEventListener('world:retry', () => {
    if (shellLoaded) return;
    void boot();
  });
</script>

<script is:inline>
  window.__worldAlert = window.__worldAlert || function () {};
</script>
