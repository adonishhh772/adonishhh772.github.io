---
import { site, nav, rootUrl } from '../site.config';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const isCurrent = (rawHref: string) => {
  const href = rootUrl(rawHref);
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={rootUrl('/')} aria-label={`${site.name} — home`}>
      <img
        class="header-avatar"
        src={rootUrl('/images/abd-bastola-avatar.jpg')}
        alt=""
        width="30"
        height="30"
        loading="eager"
      />
      <span class="wordmark-text">
        {site.name}<span class="accent-dot">.</span>
      </span>
      <span class="wordmark-tag" aria-hidden="true">AI · {site.location}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.primary.map((item) => (
          <a
            class="nav-link"
            href={rootUrl(item.href)}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <!-- The CV is the one destination that must never be hunted for. -->
      <a
        class="nav-cv"
        href={rootUrl(nav.cv.href)}
        aria-current={isCurrent(nav.cv.href) ? 'page' : undefined}
      >
        <Icon name="document" size={13} />
        {nav.cv.label}
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
  /* The header grows a signal line once the page has moved. */
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    var update = function () {
      header.toggleAttribute('data-scrolled', window.scrollY > 12);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
