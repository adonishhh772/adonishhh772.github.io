---
import { site, nav, rootUrl, hero } from '../site.config';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const isCurrent = (rawHref: string) => {
  const href = rootUrl(rawHref);
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={rootUrl('/')} aria-label={`${site.name} — home`}>
      <img
        class="header-avatar"
        src={rootUrl('/images/abd-bastola-avatar.jpg')}
        alt=""
        width="30"
        height="30"
        loading="eager"
      />
      <span class="wordmark-text">
        {site.name}<span class="accent-dot">.</span>
      </span>
      <span class="wordmark-tag" aria-hidden="true">AI · {site.location}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.primary.map((item) => (
          <a
            class="nav-link"
            href={rootUrl(item.href)}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      {/* Only offered when the browser can actually run the world. */}
      <button class="world-return" type="button" data-world-return>
        <Icon name="compass" size={13} />
        {hero.stage.worldLabel}
      </button>

      <!-- The CV is the one destination that must never be hunted for. -->
      <a
        class="nav-cv"
        href={rootUrl(nav.cv.href)}
        aria-current={isCurrent(nav.cv.href) ? 'page' : undefined}
      >
        <Icon name="document" size={13} />
        {nav.cv.label}
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    /* The header grows a signal line once the page has moved. */
    var header = document.querySelector('.site-header');
    if (header) {
      var update = function () {
        header.toggleAttribute('data-scrolled', window.scrollY > 12);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
    }

    /* Leave the readable fallback for the world again. */
    var back = document.querySelector('[data-world-return]');
    if (back) {
      back.addEventListener('click', function () {
        try {
          localStorage.setItem('world:mode', 'world');
        } catch (error) {
          /* storage unavailable — the reload picks the default anyway */
        }
        window.location.reload();
      });
    }
  })();
</script>

<style>
  /*
    The world is the primary experience, so the way back to it appears only
    when the visitor is in the readable fallback and their browser can run it.
  */
  .world-return {
    display: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 38px;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .world-return:hover {
    background: var(--accent-soft);
  }

  :global(html[data-mode='simple'][data-webgl='yes']) .world-return {
    display: inline-flex;
  }
</style>
