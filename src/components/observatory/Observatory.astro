---
/**
 * The observatory stage.
 *
 * Everything a visitor needs is server-rendered semantic HTML: the poster
 * illustration, the station menu (a native <details>, so it opens without
 * JavaScript), every preview panel with real links, and the simple view.
 * The WebGL world is loaded afterwards as an enhancement.
 */
import Icon from '../Icon.astro';
import StationPoster from './StationPoster.astro';
import { hero, stations, rootUrl, type Station } from '../../site.config';

interface ExhibitView {
  id: string;
  index: number;
  eyebrow: string;
  title: string;
  body: string;
  facts: { k: string; v: string }[];
  href: string;
  linkLabel: string;
}

interface Props {
  /** Real project data, resolved from the projects collection by the page. */
  exhibits: ExhibitView[];
}

const { exhibits } = Astro.props;

const exhibitsByStation = new Map<string, ExhibitView[]>();
for (const exhibit of exhibits) {
  const list = exhibitsByStation.get('work') ?? [];
  list.push(exhibit);
  exhibitsByStation.set('work', list);
}

/** Ordered so the most useful destinations are reached first by keyboard. */
const ordered = [...stations].sort((a, b) => {
  const rank = (s: Station) => (s.id === 'work' ? 0 : s.id === 'writing' ? 1 : 2);
  return rank(a) - rank(b);
});
---

<script is:inline>
  /**
   * Capability probe, run during parsing and before the stage is laid out.
   * Detecting WebGL late (after load) meant the fallback swapped the layout
   * under the reader — this keeps the no-WebGL path shift-free.
   */
  (function () {
    try {
      var canvas = document.createElement('canvas');
      var gl =
        canvas.getContext('webgl2') ||
        canvas.getContext('webgl') ||
        canvas.getContext('experimental-webgl');
      if (!gl) {
        document.documentElement.dataset.webgl = 'none';
        return;
      }
      var lose = gl.getExtension('WEBGL_lose_context');
      if (lose) lose.loseContext();
      document.documentElement.dataset.webgl = 'yes';
    } catch (error) {
      document.documentElement.dataset.webgl = 'none';
    }
  })();
</script>

<div class="obs" data-obs data-world="idle" data-simple="false">
  <div class="obs-stage" data-obs-stage>
    <!-- Poster: the LCP-friendly illustration, replaced once the world runs. -->
    <div class="obs-poster" data-obs-poster>
      <StationPoster />
    </div>

    <canvas
      class="obs-canvas"
      data-obs-canvas
      width="800"
      height="600"
      aria-label={hero.stage.posterAlt}
      role="img"
    >
    </canvas>

    <!-- Hotspots: real buttons, projected from the world each frame. -->
    <div class="obs-hotspots" data-obs-hotspots>
      {
        ordered.map((station, index) => (
          <button
            class="obs-hotspot"
            type="button"
            data-obs-hotspot={station.id}
            data-visible="false"
            tabindex="-1"
            aria-hidden="true"
            aria-pressed="false"
          >
            <span class="obs-hotspot-mark" aria-hidden="true">
              <Icon name={station.id === 'work' ? 'grid' : station.id === 'writing' ? 'rss' : station.id === 'contact' ? 'mail' : station.id === 'studio' ? 'user' : station.id === 'knowledge' ? 'graph' : 'compass'} size={13} />
            </span>
            <span class="obs-hotspot-name">{station.label}</span>
            <span class="obs-hotspot-role" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          </button>
        ))
      }
    </div>

    <!-- Honest status. Never a fake progress bar. -->
    <p
      class="obs-status"
      data-obs-status
      data-state="loading"
      data-message-error={hero.stage.errorLabel}
      data-message-lost="The interactive view stopped. The simple view still has everything."
      data-message-ready={hero.stage.readyLabel}
      role="status"
      aria-live="polite"
    >
      <span class="pulse" aria-hidden="true"></span>
      <span data-obs-status-text>{hero.stage.loadingLabel}</span>
    </p>

    <!-- Preview panels: one per station plus one per project exhibit. -->
    <div class="obs-panel-host">
      <div class="obs-scrim" data-obs-scrim hidden></div>

      {
        stations.map((station) => (
          <section
            class="obs-panel"
            data-obs-panel={`station:${station.id}`}
            role="dialog"
            aria-modal="true"
            aria-labelledby={`obs-panel-${station.id}-title`}
            hidden
          >
            <div class="obs-panel-head">
              <div>
                <span class="obs-panel-eyebrow">{station.alias}</span>
                <h3 class="obs-panel-title" id={`obs-panel-${station.id}-title`}>
                  {station.label}
                </h3>
              </div>
              <button
                class="obs-panel-close"
                type="button"
                data-obs-panel-close
                aria-label="Close preview"
              >
                <Icon name="close" size={15} />
              </button>
            </div>

            <div class="obs-panel-body">
              <p>{station.body}</p>

              <ul class="obs-panel-facts">
                {station.facts.map((fact) => (
                  <li>
                    <span class="k">{fact.k}</span>
                    <span class="v">{fact.v}</span>
                  </li>
                ))}
              </ul>

              {station.id === 'work' && (
                <ul class="obs-panel-exhibits">
                  {(exhibitsByStation.get('work') ?? []).map((exhibit) => (
                    <li>
                      <button type="button" data-obs-exhibit={exhibit.id}>
                        <span class="num mono">{String(exhibit.index).padStart(2, '0')}</span>
                        <span class="label">{exhibit.title}</span>
                        <span class="go">View</span>
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="obs-panel-links">
              {station.links.map((link) => (
                <a
                  class="btn btn--ghost btn--small"
                  href={link.external ? link.href : rootUrl(link.href)}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                  <Icon name={link.external ? 'arrow-up-right' : 'arrow-right'} size={13} />
                </a>
              ))}
            </div>
          </section>
        ))
      }

      {
        exhibits.map((exhibit) => (
          <section
            class="obs-panel"
            data-obs-panel={`exhibit:${exhibit.id}`}
            role="dialog"
            aria-modal="true"
            aria-labelledby={`obs-exhibit-${exhibit.id}-title`}
            hidden
          >
            <div class="obs-panel-head">
              <div>
                <span class="obs-panel-eyebrow">{exhibit.eyebrow}</span>
                <h3 class="obs-panel-title" id={`obs-exhibit-${exhibit.id}-title`}>
                  {exhibit.title}
                </h3>
              </div>
              <button
                class="obs-panel-close"
                type="button"
                data-obs-panel-close
                aria-label="Close preview"
              >
                <Icon name="close" size={15} />
              </button>
            </div>

            <div class="obs-panel-body">
              <p>{exhibit.body}</p>
              <ul class="obs-panel-facts">
                {exhibit.facts.map((fact) => (
                  <li>
                    <span class="k">{fact.k}</span>
                    <span class="v">{fact.v}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="obs-panel-links">
              <a class="btn btn--primary btn--small" href={exhibit.href}>
                {exhibit.linkLabel}
                <Icon name="arrow-right" size={13} />
              </a>
              <button
                class="btn btn--ghost btn--small"
                type="button"
                data-obs-panel-back
                data-obs-panel-back-to="station:work"
              >
                Back to the pavilion
              </button>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <!-- Stage controls: explore, reset, exit, and the station menu. -->
  <div class="obs-controls" data-obs-controls data-mode="ambient">
    <button
      class="btn btn--primary btn--small"
      type="button"
      data-obs-explore
      aria-pressed="false"
    >
      <Icon name="compass" size={14} />
      {hero.stage.exploreLabel}
    </button>

    <button class="btn btn--ghost btn--small" type="button" hidden data-obs-reset>
      {hero.stage.resetLabel}
    </button>

    <button class="btn btn--ghost btn--small" type="button" hidden data-obs-exit>
      {hero.stage.exitLabel}
    </button>

    <span class="spacer"></span>
  </div>

  <details class="obs-menu" data-obs-menu>
    <summary>
      <Icon name="compass" size={14} />
      {hero.stage.menuLabel}
    </summary>
    <ul class="obs-menu-list">
      {
        ordered.map((station, index) => (
          <li>
            <button
              class="obs-menu-item"
              type="button"
              data-obs-menu-item={station.id}
              aria-current="false"
            >
              <span class="obs-menu-num">{String(index + 1).padStart(2, '0')}</span>
              <span>
                <span class="obs-menu-name">{station.label}</span>
                <span class="obs-menu-blurb">{station.blurb}</span>
              </span>
              <span class="obs-menu-go">{station.alias}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </details>

  <!-- Utility row: motion, quality, discoveries, simple view. -->
  <div class="obs-utility">
    <button
      class="obs-switch"
      type="button"
      data-obs-pause
      aria-pressed="false"
      data-label-pause={hero.stage.pauseLabel}
      data-label-resume={hero.stage.resumeLabel}
    >
      <span class="obs-switch-track" aria-hidden="true"></span>
      <span data-obs-pause-label>{hero.stage.pauseLabel}</span>
    </button>

    <span class="dot-sep" aria-hidden="true"></span>

    <label class="obs-quality">
      <span>Quality</span>
      <select data-obs-quality>
        <option value="auto">Auto</option>
        <option value="high">Full</option>
        <option value="medium">Balanced</option>
        <option value="low">Lite</option>
      </select>
    </label>

    <span class="dot-sep" aria-hidden="true"></span>

    <span class="obs-discoveries">
      Light markers found
      <strong data-obs-discoveries>0 / 3</strong>
    </span>

    <span class="dot-sep" aria-hidden="true"></span>

    <button class="obs-switch" type="button" data-obs-simple-toggle aria-pressed="false">
      {hero.stage.simpleLabel}
    </button>

    <button class="obs-switch" type="button" data-obs-world-toggle hidden>
      {hero.stage.worldLabel}
    </button>
  </div>

  <!-- Simple view: every destination, no WebGL, no JavaScript required. -->
  <section class="obs-simple" data-obs-simple-view hidden aria-labelledby="obs-simple-title">
    <span class="kicker kicker--plain">Simple view</span>
    <h3 class="h3-title" id="obs-simple-title" style="margin: 0.7rem 0 0.5rem;">
      Every station, without the 3D world
    </h3>
    <p class="muted" style="max-width: 58ch; font-size: 0.92rem;">
      The observatory is an enhancement. Everything it shows is a real page on
      this site — these links go straight there.
    </p>
    <div class="obs-simple-grid">
      {
        ordered.map((station) => (
          <a class="obs-simple-card" href={rootUrl(station.links[0]?.href ?? '/')}>
            <strong>{station.label}</strong>
            <span>{station.blurb}</span>
            <span class="go">
              {station.alias}
              {' →'}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</div>

<style>
  .obs-panel-exhibits {
    list-style: none;
    margin: 0 0 0.4rem;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .obs-panel-exhibits button {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 44px;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--surface-1);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .obs-panel-exhibits button:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .obs-panel-exhibits .num {
    font-size: 0.64rem;
    color: var(--faint);
  }

  .obs-panel-exhibits .label {
    font-size: 0.86rem;
    color: var(--text-soft);
  }

  .obs-panel-exhibits .go {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .obs-quality {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .obs-quality select {
    min-height: 34px;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }

  .obs-discoveries strong {
    color: var(--signal);
    font-weight: 600;
    margin-left: 0.3rem;
  }
</style>

<script>
  /**
   * Observatory bootstrap.
   *
   * Deliberately tiny: it exists so the three.js chunk is only fetched
   * after the page has painted, and so a failure anywhere in the world
   * degrades to the simple view instead of a blank canvas.
   */
  import type { ObservatoryHandle } from '../../lib/observatory/controller';

  const root = document.querySelector<HTMLElement>('[data-obs]');

  if (root) {
    let handle: ObservatoryHandle | null = null;
    let stopped = false;

    const fail = (message?: string) => {
      root.dataset.world = 'failed';
      root.dataset.simple = 'true';
      const simple = root.querySelector<HTMLElement>('[data-obs-simple-view]');
      if (simple) simple.hidden = false;
      /* A reload is the only retry that can work when mounting threw. */
      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-obs-world-toggle]')) {
        button.hidden = false;
        button.addEventListener('click', () => window.location.reload());
      }
      const status = root.querySelector<HTMLElement>('[data-obs-status]');
      if (status) {
        status.dataset.state = 'error';
        status.hidden = false;
        const text = status.querySelector('[data-obs-status-text]');
        if (text) {
          text.textContent =
            message ?? 'The interactive view could not start. The simple view still has everything.';
        }
      }
    };

    const boot = async () => {
      if (stopped) return;
      try {
        const { mountObservatory } = await import('../../lib/observatory/controller');
        if (stopped) return;
        handle = mountObservatory(root);
      } catch (error) {
        fail(
          error instanceof Error && /webgl/i.test(error.message)
            ? root.querySelector<HTMLElement>('[data-obs-status]')?.dataset.messageError
            : 'The interactive view could not start. The simple view still has everything.',
        );
      }
    };

    /* Let HTML, CSS and the poster have the first paint to themselves. */
    const schedule = () => {
      const idle = (
        window as Window & {
          requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
        }
      ).requestIdleCallback;
      if (typeof idle === 'function') {
        idle(() => void boot(), { timeout: 900 });
      } else {
        window.setTimeout(() => void boot(), 180);
      }
    };

    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });

    const teardown = () => {
      stopped = true;
      handle?.dispose();
      handle = null;
    };
    window.addEventListener('pagehide', teardown, { once: true });
    document.addEventListener('astro:before-swap', teardown, { once: true });
  }
</script>
