---
// Elegant project card used on the home page selected-work grid and /work.
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ProjectDiagram from './observatory/ProjectDiagram.astro';
import { rootUrl } from '../site.config';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Zero-padded index label, e.g. "01". */
  index: string;
  /** Stagger delay for the scroll reveal, in ms. */
  delay?: number;
}

const { project, index, delay = 0 } = Astro.props;
const { data } = project;
const href = rootUrl(`/work/${project.id}/`);

/** Short caption for the architecture sketch, drawn from the case study. */
const diagramCaptions: Record<string, string> = {
  kai: 'Multi-agent RAG: route, retrieve, synthesise, verify — with guardrails and an approval gate.',
  'education-platform': 'Document structure → schema-validated extraction → knowledge graph → cited answers.',
  hyperran: 'Demand forecast feeding a policy constrained by a non-negotiable QoS floor.',
};
---

<article
  class="card card--hover project-card"
  data-project={project.id}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <div class="project-card-top">
    <span class="project-index" aria-hidden="true">{index}</span>
    <span class="project-status">{data.tag}</span>
  </div>

  <h3 class="h3-title">
    <a href={href} class="project-title-link">{data.title}</a>
  </h3>

  <ProjectDiagram
    projectId={project.id}
    caption={diagramCaptions[project.id] ?? data.tag}
  />

  <p class="project-summary">{data.summary}</p>

  {
    data.themes.length > 0 && (
      <ul class="chips" aria-label={`${data.shortTitle} — key themes`}>
        {data.themes.slice(0, 5).map((theme) => (
          <li class="chip">{theme}</li>
        ))}
      </ul>
    )
  }

  <a class="link-arrow project-card-cta" href={href}>
    Read the case study
    <Icon name="arrow-right" size={16} />
  </a>

  {
    data.links.length > 0 && (
      <ul class="project-ext-links" aria-label="External links">
        {data.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
              <Icon name="arrow-up-right" size={12} />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project-card-cta {
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }

  .project-card :global(.project-figure) {
    margin-bottom: 0.9rem;
  }
</style>
