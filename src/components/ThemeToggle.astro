---
// Light/dark theme toggle for the readable (no-JavaScript and no-WebGL)
// presentation of the site.
//
// In the world this control lives in the persistent chrome, which is above the
// reading surfaces. Both share one authoritative state (see
// src/lib/world/theme-state.ts), and both are wired by the same delegated
// handler, so the two can never disagree or double-fire.
import Icon from './Icon.astro';
---

<button
  class="theme-toggle icon-link"
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Switch to night lighting"
  title="Night lighting"
>
  <span class="theme-icon theme-icon--dark" aria-hidden="true">
    <Icon name="moon" size={15} />
  </span>
  <span class="theme-icon theme-icon--light" aria-hidden="true">
    <Icon name="sun" size={15} />
  </span>
  <span class="visually-hidden" data-theme-state>Night</span>
</button>

<style>
  .theme-toggle {
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .theme-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    inset: 0;
    transition: opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  /* Dark theme (default): show the moon; light theme: show the sun. */
  .theme-icon--light {
    opacity: 0;
    transform: rotate(-40deg) scale(0.7);
  }

  :global(html[data-theme='light']) .theme-icon--dark {
    opacity: 0;
    transform: rotate(40deg) scale(0.7);
  }

  :global(html[data-theme='light']) .theme-icon--light {
    opacity: 1;
    transform: none;
  }
</style>

<script is:inline>
  /**
   * Fallback only. The delegated handler in src/lib/world/chrome.ts owns this
   * control; this listener stands down the moment that module is active, so
   * the theme is never toggled twice and the button keeps working even when
   * the world module is the thing that failed.
   */
  (function () {
    if (window.__abdThemeDelegated) return;
    document.addEventListener('click', function (event) {
      if (window.__abdThemeDelegated) return;
      var target = event.target;
      if (!target || !target.closest) return;
      var button = target.closest('[data-theme-toggle]');
      if (!button) return;
      if (document.querySelector('[data-world-stage]')) return;
      var root = document.documentElement;
      var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      root.setAttribute('data-theme-anim', 'true');
      window.setTimeout(function () {
        if (root.getAttribute('data-theme') === next) root.removeAttribute('data-theme-anim');
      }, 780);
      try {
        localStorage.setItem('theme', next);
      } catch (error) {
        /* storage unavailable — the theme still applies for this page */
      }
      document.dispatchEvent(
        new CustomEvent('world:themechange', { detail: { theme: next, animate: true } })
      );
    });
  })();
</script>
