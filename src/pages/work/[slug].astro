---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectDiagram from '../../components/observatory/ProjectDiagram.astro';
import { rootUrl } from '../../site.config';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;

/** Section navigation from the case study's own h2 headings. */
const sections = headings.filter((heading) => heading.depth === 2);

const diagramCaptions: Record<string, string> = {
  kai: 'Multi-agent RAG: route, retrieve, synthesise, verify — with guardrails and an approval gate.',
  'education-platform': 'Document structure → schema-validated extraction → knowledge graph → cited answers.',
  hyperran: 'Demand forecast feeding a policy constrained by a non-negotiable QoS floor.',
};

const title = `${data.title} — case study`;
---

<BaseLayout title={title} description={data.summary} type="article">
  <article>
    <header class="article-header">
      <div class="wrap">
        <p class="article-kicker">
          <a href={rootUrl('/work')} class="back-link">
            <Icon name="arrow-right" size={13} />
            Work
          </a>
          <span aria-hidden="true">·</span>
          Case study
          <span aria-hidden="true">·</span>
          {data.readingTime}
        </p>
        <h1 class="article-title">{data.title}</h1>
        <p class="article-lead">{data.context}</p>
        <ul class="chips" aria-label="Key themes">
          {data.themes.map((theme) => (
            <li class="chip">{theme}</li>
          ))}
        </ul>
        {
          data.links.length > 0 && (
            <div class="case-links-block">
              <span class="case-links-label micro">External links</span>
              <ul class="case-links" aria-label="External links">
                {data.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${link.label} (opens in a new tab)`}
                    >
                      {link.label}
                      <Icon name="arrow-up-right" size={13} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </header>

    <div class="wrap article-body-wrap">
      <div class="case-layout">
        {
          sections.length > 2 ? (
            <nav class="case-contents" aria-label="Sections of this case study">
              <span class="contents-label mono">On this page</span>
              <ol>
                {sections.map((section, index) => (
                  <li>
                    <a href={`#${section.slug}`} data-case-link={section.slug}>
                      <span class="mono num">{String(index + 1).padStart(2, '0')}</span>
                      {section.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : (
            <div />
          )
        }

        <div>
          <ProjectDiagram
            projectId={project.id}
            caption={diagramCaptions[project.id] ?? data.tag}
          />

          <div class="prose">
            <Content />
          </div>
        </div>
      </div>

      <footer class="case-footer">
        <a class="link-arrow" href={rootUrl('/work')}>
          <Icon name="arrow-right" size={15} />
          Back to all work
        </a>
        <p>
          Case studies are anonymised to protect client confidentiality.
          Implementations are described separately from outcomes.
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .project-figure {
    margin: 0 0 2rem;
    max-width: 38rem;
  }

  .contents-label {
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .case-contents ol {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    counter-reset: none;
  }

  .case-contents a {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 36px;
    padding: 0.35rem 0.6rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.4;
    transition: color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .case-contents a .num {
    font-size: 0.62rem;
    color: var(--faint);
  }

  .case-contents a:hover {
    color: var(--text);
    background: var(--hover-bg);
  }

  .case-contents a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 999px) {
    .case-contents {
      position: static;
      border: 1px solid var(--hairline);
      border-radius: var(--radius);
      background: var(--surface-1);
      padding: 0.9rem 1rem 1rem;
      margin-bottom: 1.6rem;
    }

    .case-contents ol {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    }
  }
</style>

<script is:inline>
  /* Highlight the section currently being read. */
  (function () {
    var links = document.querySelectorAll('[data-case-link]');
    if (!links.length || !('IntersectionObserver' in window)) return;

    var map = {};
    links.forEach(function (link) {
      map[link.getAttribute('data-case-link')] = link;
    });

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          links.forEach(function (link) {
            link.classList.remove('is-active');
          });
          var active = map[entry.target.id];
          if (active) active.classList.add('is-active');
        });
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );

    document.querySelectorAll('.prose h2[id]').forEach(function (heading) {
      observer.observe(heading);
    });
  })();
</script>
