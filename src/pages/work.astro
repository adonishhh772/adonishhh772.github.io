---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MiniProjectCard from '../components/MiniProjectCard.astro';
import { site, social, rootUrl } from '../site.config';
import { githubProjects, type GithubProject } from '../data/github-projects';
import { getCollection, type CollectionEntry } from 'astro:content';

const categories: GithubProject['category'][] = [
  'AI & agents',
  'ML & RL research',
  'Automation & platform',
];

/** Slug used by the filter buttons and the category blocks. */
const categorySlug = (category: GithubProject['category']) =>
  category === 'AI & agents'
    ? 'ai-agents'
    : category === 'ML & RL research'
      ? 'ml-research'
      : 'automation';

const projectOrder = ['kai', 'education-platform', 'hyperran'];
const allProjects = await getCollection('projects');
const projectsById = new Map(allProjects.map((p) => [p.id, p]));
const projects = projectOrder
  .map((id) => projectsById.get(id))
  .filter((p): p is CollectionEntry<'projects'> => Boolean(p));

const title = 'Work — Selected projects';
---

<BaseLayout
  title={title}
  description={`Selected work by ${site.name}: enterprise AI assistants, GraphRAG platforms and applied research — each with an anonymised case study.`}
>
  <section class="page-head">
    <div class="wrap">
      <span class="kicker">Selected work</span>
      <h1 class="display display--page">Work</h1>
      <p class="lede">
        A selection of engagements and systems across enterprise AI
        assistants, GraphRAG platforms and applied research. Client names and
        commercially sensitive detail are anonymised; each case study covers
        the problem, my role, the approach and what was learned.
      </p>
      <div class="page-head-actions">
        <a class="btn btn--ghost" href={rootUrl('/about')}>
          More about how I work
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Projects">
    <div class="wrap">
      <div class="work-filters" role="group" aria-label="Filter projects">
        <button class="filter-btn is-active" type="button" data-filter="all" aria-pressed="true">
          All
        </button>
        <button class="filter-btn" type="button" data-filter="case-studies" aria-pressed="false">
          Case studies
        </button>
        <button class="filter-btn" type="button" data-filter="ai-agents" aria-pressed="false">
          AI &amp; agents
        </button>
        <button class="filter-btn" type="button" data-filter="ml-research" aria-pressed="false">
          ML &amp; RL research
        </button>
        <button class="filter-btn" type="button" data-filter="automation" aria-pressed="false">
          Automation &amp; platform
        </button>
        <p class="filter-count" id="filter-count" aria-live="polite"></p>
      </div>

      <div class="work-list" data-cat-block="case-studies">
        {
          projects.map((project, i) => (
            <article
              class="card card--hover work-item"
              data-cat="case-studies"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <div class="work-item-meta">
                <span class="project-index" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="project-status">{project.data.tag}</span>
              </div>

              <div>
                <h2 class="work-item-title">
                  <a href={rootUrl(`/work/${project.id}/`)}>{project.data.title}</a>
                </h2>
                <p class="project-summary">{project.data.summary}</p>
                <ul class="chips" aria-label={`${project.data.shortTitle} themes`}>
                  {project.data.themes.map((theme) => (
                    <li class="chip">{theme}</li>
                  ))}
                </ul>
                {
                  project.data.links.length > 0 && (
                    <ul class="project-ext-links" aria-label="External links">
                      {project.data.links.map((link) => (
                        <li>
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {link.label}
                            <Icon name="arrow-up-right" size={12} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>

              <div class="work-item-cta">
                <a
                  class="link-arrow"
                  href={rootUrl(`/work/${project.id}/`)}
                  aria-label={`Read the ${project.data.shortTitle} case study`}
                >
                  Case study
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="work-note" style="margin-top: 2.2rem;">
        <p>
          Each engagement is different, but the shape of the work is
          consistent: understand the business problem, pressure-test the data,
          design the smallest reliable system, instrument everything, and
          agree how success will be measured before the first model is chosen.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Open source & builds ─────────────────────────────────── -->
  <section class="section section--rule" id="open-source" aria-labelledby="open-source-title">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">GitHub · {githubProjects.length} public repositories</span>
          <h2 class="section-title" id="open-source-title" style="margin-top: 0.8rem;">
            Open source &amp; builds
          </h2>
          <p class="lede" style="margin-top: 0.7rem;">
            Agents, GraphRAG experiments, reinforcement learning for RAN and
            automation tooling — all public on GitHub.
          </p>
        </div>
        <a
          class="link-arrow"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          Follow on GitHub
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>

      {
        categories.map((category) => (
          <div class="project-category" data-cat-block={categorySlug(category)}>
            <h3 class="project-category-title mono">{category}</h3>
            <div class="mini-project-grid">
              {githubProjects
                .filter((project) => project.category === category)
                .map((project, i) => (
                  <MiniProjectCard project={project} delay={i * 60} />
                ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <noscript>
    <style>
      .work-filters {
        display: none;
      }
    </style>
  </noscript>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll('.filter-btn[data-filter]');
      var count = document.getElementById('filter-count');
      if (!buttons.length) return;

      var cards = document.querySelectorAll('[data-cat]');
      var blocks = document.querySelectorAll('[data-cat-block]');
      var total = cards.length;

      function apply(filter) {
        var shown = 0;
        cards.forEach(function (card) {
          var match = filter === 'all' || card.getAttribute('data-cat') === filter;
          card.hidden = !match;
          if (match) shown++;
        });

        blocks.forEach(function (block) {
          var anyVisible = block.querySelector('[data-cat]:not([hidden])');
          block.hidden = !anyVisible;
        });

        buttons.forEach(function (button) {
          var active = button.getAttribute('data-filter') === filter;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        if (count) {
          count.textContent =
            'Showing ' + shown + ' of ' + total + ' projects';
        }
      }

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          apply(button.getAttribute('data-filter'));
        });
      });

      apply('all');
    })();
  </script>
</BaseLayout>

<style>
  .work-item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    line-height: 1.5;
  }

  @media (min-width: 860px) {
    .work-item-meta {
      padding-top: 0.3rem;
    }

    .work-item-cta {
      display: flex;
      justify-content: flex-end;
      padding-top: 0.3rem;
    }
  }

  .work-item h2 a {
    transition: color var(--dur) var(--ease);
  }

  .work-item:hover h2 a {
    color: var(--accent);
  }

  .work-item .project-summary {
    margin-bottom: 1.1rem;
  }

  .work-note {
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
    border-left: 2px solid var(--hairline-strong);
    padding-left: 1.2rem;
  }

  .work-note p {
    margin: 0;
  }

  .project-category + .project-category {
    margin-top: 2.6rem;
  }

  .project-category-title {
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .mini-project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 980px) {
    .mini-project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .mini-project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
