---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, newsletter, social, contact, rootUrl } from '../site.config';

const title = 'CV — Abd Bastola';

const focusAreas = [
  'Enterprise RAG & GraphRAG',
  'AI agents & orchestration',
  'Evaluation & response validation',
  'Guardrails & responsible AI',
  'Prompt engineering & versioning',
  'Document intelligence',
  'Azure AI Foundry / GCP delivery',
  'LLMOps & production support',
];

const toolkit = [
  'Python',
  'SQL',
  'JavaScript',
  'TypeScript',
  'React',
  'LLM applications',
  'RAG',
  'Semantic retrieval',
  'Prompt engineering',
  'Prompt evaluation',
  'AI agents',
  'Response validation',
  'Guardrails',
  'OpenAI API',
  'Claude',
  'Azure AI Foundry',
  'LangChain',
  'LangGraph',
  'Custom GPT workflows',
  'FastAPI',
  'REST APIs',
  'Full-stack delivery',
  'API integration',
  'Backend orchestration',
  'Embeddings',
  'Vector search',
  'Data pipelines',
  'Reporting workflows',
  'Large-context systems',
  'GCP',
  'AWS',
  'Azure',
  'Docker',
  'Kubernetes',
  'CI/CD',
  'Linux',
  'Redis',
  'GCP Pub/Sub',
  'Debugging',
  'Production support',
];

const experience = [
  {
    role: 'Lead AI Engineer / GenAI Specialist',
    org: 'AWTG Ltd',
    period: 'May 2022 – Present',
    where: 'London, UK',
    bullets: [
      'Contribute to the KAI AI platform — production-grade LLM workflows, Python/FastAPI services, backend systems, data pipelines and reusable AI capabilities — supporting enterprise AI adoption for 65,000+ active users, including the British Council.',
      'Led AI engineering delivery for an education platform (not yet publicly launched) — translating product, pedagogy and user needs into scalable, AI-enabled platform features and production-ready capabilities.',
      'Built RAG and document-grounded AI workflows across approved knowledge sources, retrieval logic, structured context, embeddings and vector search, prompt construction and response validation.',
      'Designed agent-style AI workflows and LangGraph/LangChain-style orchestration that connect LLMs with retrieval, backend APIs and tool-style service calls — multi-step logic, error handling and validated outputs.',
      'Improved document-intelligence workflows by processing structured and unstructured data, running data-quality checks and preparing content for retrieval.',
      'Strengthened safe, responsible AI delivery through prompt versioning, approved knowledge sources, guardrails, response constraints, controlled releases and mitigation of hallucination, data leakage, prompt injection and unsafe outputs.',
      'Reduced manual reporting effort by 40% with automated data pipelines and reporting workflows, and improved network energy efficiency by 28% across 200+ network nodes with optimisation, analytics and decision-support tooling.',
      'Operate cloud-native AI services on GCP and Azure AI Foundry with Docker, Kubernetes, Redis and GCP Pub/Sub — CI/CD, structured logging, debugging, root-cause analysis and cross-team knowledge sharing.',
    ],
  },
  {
    role: 'AI Research and Computing Support Apprenticeship',
    org: 'Teesside University',
    period: 'Sep 2022 – May 2023',
    where: 'United Kingdom',
    bullets: [
      'Supported AI-focused research prototypes by configuring Python workflows, reproducible environments, automation tools, testing and technical documentation.',
      'Improved reliability of research computing environments through Linux setup, access management, performance checks, troubleshooting and issue investigation.',
      'Explained software and infrastructure issues clearly to technical and non-technical users.',
    ],
  },
  {
    role: 'Machine Learning Engineer',
    org: 'Unifun',
    period: 'Oct 2017 – Oct 2020',
    where: 'Kathmandu, Nepal',
    bullets: [
      'Delivered AI and machine-learning capabilities for product and business use cases — data preparation, model experimentation, backend integration, testing, deployment and documentation.',
      'Built Python-based ML and automation workflows processing structured and unstructured data, with predictive analysis and repeatable data-driven tasks.',
      'Built NLP workflows, recommendation-style logic, search functionality, model evaluation and integrations between AI outputs and user-facing systems.',
      'Improved model reliability and data quality by validating features, reviewing failure cases and documenting issues across ML-enabled features.',
    ],
  },
];

const achievements = [
  'Improved automation workflow coverage by 35% through backend logic and API integrations for orchestration and intelligent task execution.',
  'Accelerated 5G validation and test-cycle analysis by 70% through improved data-ingestion and visualisation modules.',
  'Contributed to scalable CI/CD and operational practices supporting 99.9% uptime for telecom AI and automation services.',
];

const education = [
  {
    degree: 'MSc Computing, Distinction',
    org: 'Teesside University',
    period: '2021 – 2023',
  },
  {
    degree: 'BSc Computing, First Class Honours',
    org: 'Leeds Beckett University',
    period: '2018',
  },
];

const activities = [
  'Active AI, ML and data-science writer on LinkedIn — including the Reliable AI newsletter.',
  'Member and mentor of the LangChain community in London, supporting AI agent, RAG and multi-agent architecture discussions.',
  'Contributor to open-source AI projects and MLOps best-practice sharing at cloud and AI engineering meetups.',
];

const engagements = [
  {
    id: 'kai',
    name: 'KAI — Enterprise knowledge assistant',
    tag: 'Enterprise AI platform · AWTG',
    line: 'The AI platform behind enterprise knowledge workflows — production LLM services, RAG and document-grounded answers serving 65,000+ active users, including the British Council.',
  },
  {
    id: 'education-platform',
    name: 'Education platform — GraphRAG for complex learning content',
    tag: 'EdTech · Not yet public',
    line: 'GraphRAG and document intelligence for complex learning content — connected, verifiable knowledge with measured citation accuracy (platform not yet launched).',
  },
  {
    id: 'hyperran',
    name: 'Hiper-RAN — AI optimisation for telecom networks',
    tag: 'Telecom network optimisation',
    line: 'Optimisation, analytics and decision-support tooling for RAN — improving network energy efficiency by 28% across 200+ network nodes.',
  },
];
---

<BaseLayout
  title={title}
  description={`CV for ${site.name}: Lead AI Engineer at AWTG Ltd (London) — experience, skills, selected projects, education and contact.`}
>
  <section class="page-head">
    <div class="wrap">
      <span class="kicker">CV</span>
      <h1 class="display display--page" style="margin-top: 0.9rem;">
        {site.name}
      </h1>
      <p class="lede">
        Lead AI Engineer · AWTG Ltd, London, UK. Building reliable enterprise
        AI systems across RAG, GraphRAG, agents, evaluation and responsible
        AI delivery.
      </p>
      <div class="page-head-actions">
        <a class="btn btn--ghost" href={`mailto:${contact.email}`}>
          <Icon name="mail" size={15} />
          {contact.email}
        </a>
        <a class="btn btn--ghost" href={`tel:${contact.phone.replace(/\s/g, '')}`}>
          {contact.phone}
        </a>
        <a
          class="btn btn--ghost"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={15} />
          GitHub
        </a>
        <a
          class="btn btn--ghost"
          href={social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="linkedin" size={15} />
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <!-- Summary -->
    <div class="cv-section">
      <h2 class="cv-section-title">Summary</h2>
      <p class="cv-summary">
        Lead AI Engineer in London with a track record of taking AI from
        prototype to production in enterprise settings. Currently leading AI
        engineering for AWTG — contributing to the KAI AI platform and leading
        delivery on an education-platform project — with a career
        spanning machine learning engineering, research-computing support and
        production GenAI. Comfortable across the whole delivery arc: problem
        definition, retrieval and RAG/GraphRAG design, agent orchestration,
        response validation, guardrails, evaluation and cloud-native
        operations on Azure AI Foundry and GCP. Works at the intersection of
        consulting, product thinking and hands-on engineering.
      </p>
    </div>

    <!-- Focus areas -->
    <div class="cv-section">
      <h2 class="cv-section-title">Focus areas</h2>
      <ul class="chips" style="row-gap: 0.6rem;">
        {focusAreas.map((area) => (
          <li class="chip chip--lg">{area}</li>
        ))}
      </ul>
    </div>

    <!-- Experience -->
    <div class="cv-section">
      <h2 class="cv-section-title">Experience</h2>
      {experience.map((job) => (
        <div class="cv-row">
          <div>
            <h3>{job.role}</h3>
            <p class="org">
              {job.org} · {job.where}
            </p>
            <ul>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
          <div class="period">{job.period}</div>
        </div>
      ))}
    </div>

    <!-- Selected projects -->
    <div class="cv-section">
      <h2 class="cv-section-title">Selected projects</h2>
      <div class="projects-list">
        {engagements.map((project, i) => (
          <a class="cv-project" href={rootUrl(`/work/${project.id}/`)}>
            <span class="cv-project-num mono">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="cv-project-body">
              <strong>{project.name}</strong>
              <span class="mono cv-project-tag">{project.tag}</span>
              <span class="cv-project-line">{project.line}</span>
            </span>
            <span class="cv-project-arrow">
              <Icon name="arrow-up-right" size={16} />
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Achievements -->
    <div class="cv-section">
      <h2 class="cv-section-title">Achievements</h2>
      <ul class="achievement-list">
        {achievements.map((item, i) => (
          <li>
            <span class="achievement-num mono">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Technical toolkit -->
    <div class="cv-section">
      <h2 class="cv-section-title">Technical toolkit</h2>
      <ul class="chips">
        {toolkit.map((tool) => (
          <li class="chip">{tool}</li>
        ))}
      </ul>
    </div>

    <!-- Education -->
    <div class="cv-section">
      <h2 class="cv-section-title">Education</h2>
      {education.map((entry) => (
        <div class="cv-row">
          <div>
            <h3>{entry.degree}</h3>
            <p class="org">{entry.org}</p>
          </div>
          <div class="period">{entry.period}</div>
        </div>
      ))}
    </div>

    <!-- Activities -->
    <div class="cv-section">
      <h2 class="cv-section-title">Activities & community</h2>
      <ul class="achievement-list">
        {activities.map((item, i) => (
          <li>
            <span class="achievement-num mono">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div class="cv-section">
      <h2 class="cv-section-title">Contact</h2>
      <div class="contact-links">
        <a class="btn btn--ghost" href={`mailto:${contact.email}`}>
          <Icon name="mail" size={15} />
          Email
        </a>
        <a class="btn btn--ghost" href={`tel:${contact.phone.replace(/\s/g, '')}`}>
          {contact.phone}
        </a>
        <a
          class="btn btn--ghost"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" size={15} />
          GitHub
        </a>
        <a
          class="btn btn--ghost"
          href={social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="linkedin" size={15} />
          LinkedIn
        </a>
        <a class="btn btn--ghost" href={newsletter.rssPath}>
          <Icon name="rss" size={15} />
          RSS
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-summary {
    max-width: 72ch;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 0;
  }

  .chip--lg {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    color: var(--text-soft);
  }

  .projects-list {
    display: grid;
    gap: 0.9rem;
  }

  .cv-project {
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    gap: 0.9rem;
    align-items: start;
    padding: 1.15rem 1.2rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: rgba(16, 19, 26, 0.4);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cv-project:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .cv-project-num {
    color: var(--accent);
    font-size: 0.8rem;
    padding-top: 0.2rem;
  }

  .cv-project-body {
    display: grid;
    gap: 0.3rem;
  }

  .cv-project-tag {
    color: var(--faint);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cv-project-line {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .cv-project-arrow {
    color: var(--faint);
    padding-top: 0.25rem;
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cv-project:hover .cv-project-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .achievement-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    max-width: 72ch;
  }

  .achievement-list li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.9rem;
    align-items: baseline;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .achievement-num {
    color: var(--accent);
    font-size: 0.78rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
</style>
