---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import CoffeeCard from '../../components/CoffeeCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { newsletter, rootUrl } from '../../site.config';
import { formatDate, readTimeInMinutes } from '../../lib/format';
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const readMins = readTimeInMinutes(post.body ?? '');

/** Contents rail for genuinely long pieces — not for short notes. */
const sections = headings.filter((heading) => heading.depth === 2);
const showContents = sections.length >= 4;

// Related reading: the two most recent articles other than this one.
const others = (await getCollection('writing'))
  .filter((p) => !p.data.draft && p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const title = data.title;
---

<BaseLayout title={title} description={data.description} type="article"
  destination="library"
  surface="article"
  surfaceId={post.id}
  backHref="/writing/"
>
  <article>
    <!-- Article header -->
    <header class="article-header">
      <div class="wrap">
        <p class="article-kicker">
          <a href={rootUrl('/writing')} class="back-link">
            <Icon name="arrow-right" size={13} />
            {newsletter.name}
          </a>
          {data.issue && (
            <>
              <span aria-hidden="true">·</span>
              Issue {String(data.issue).padStart(2, '0')}
            </>
          )}
          <span aria-hidden="true">·</span>
          {readMins} min read
        </p>

        <h1 class="article-title">{data.title}</h1>

        <div class="article-meta">
          <time datetime={data.pubDate.toISOString()}>
            {formatDate(data.pubDate)}
          </time>
          {data.updatedDate && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span>Updated {formatDate(data.updatedDate)}</span>
            </>
          )}
          {data.tags.length > 0 && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span>{data.tags.join(' · ')}</span>
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Article body -->
    <div class="wrap article-body-wrap">
      <div class:list={['article-layout', { 'article-layout--railed': showContents }]}>
        {
          showContents ? (
            <nav class="case-contents" aria-label="Sections of this article">
              <span class="contents-label mono">On this page</span>
              <ol>
                {sections.map((section, index) => (
                  <li>
                    <a href={`#${section.slug}`} data-case-link={section.slug}>
                      <span class="mono num">{String(index + 1).padStart(2, '0')}</span>
                      {section.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : (
            <div />
          )
        }

        <div class="prose">
          <Content />
        </div>
      </div>

      <!-- Bottom of every article: sign-up + support -->
      <div class="post-end">
        <NewsletterSignup />
        <CoffeeCard />
      </div>

      <nav class="article-end-nav" aria-label="More writing">
        <a class="link-arrow" href={rootUrl('/writing')}>
          <Icon name="arrow-right" size={15} />
          All {newsletter.name} articles
        </a>

        {
          others.length > 0 && (
            <div class="related">
              <p class="related-label micro">Keep reading</p>
              <div class="related-grid">
                {others.map((other) => (
                  <ArticleCard article={other} showDescription={false} />
                ))}
              </div>
            </div>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 1060px) {
    .article-layout--railed {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
  }

  .article-layout .prose {
    max-width: 68ch;
  }

  .contents-label {
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .case-contents ol {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .case-contents a {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 36px;
    padding: 0.35rem 0.6rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.4;
    transition: color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .case-contents a .num {
    font-size: 0.62rem;
    color: var(--faint);
  }

  .case-contents a:hover {
    color: var(--text);
    background: var(--hover-bg);
  }

  .case-contents a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 1059px) {
    .case-contents {
      position: static;
      border: 1px solid var(--hairline);
      border-radius: var(--radius);
      background: var(--surface-1);
      padding: 0.9rem 1rem 1rem;
      margin-bottom: 0.5rem;
    }

    .case-contents ol {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    }
  }

  .post-end {
    margin-top: 3rem;
  }

  .article-end-nav {
    margin-top: 3rem;
    display: grid;
    gap: 2rem;
  }

  .related-label {
    color: var(--faint);
    margin: 0 0 0.8rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  @media (max-width: 720px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
