---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import CoffeeCard from '../../components/CoffeeCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { newsletter } from '../../site.config';
import { formatDate, readTimeInMinutes } from '../../lib/format';
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const readMins = readTimeInMinutes(post.body ?? '');

// Related reading: the two most recent articles other than this one.
const others = (await getCollection('writing'))
  .filter((p) => !p.data.draft && p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const title = data.title;
---

<BaseLayout title={title} description={data.description} type="article">
  <article>
    <!-- Article header -->
    <header class="article-header">
      <div class="wrap">
        <p class="article-kicker">
          <a href="/writing" class="back-link">
            <Icon name="arrow-right" size={13} />
            {newsletter.name}
          </a>
          {data.issue && (
            <>
              <span aria-hidden="true">·</span>
              Issue {String(data.issue).padStart(2, '0')}
            </>
          )}
        </p>

        <h1 class="article-title">{data.title}</h1>

        <div class="article-meta">
          <time datetime={data.pubDate.toISOString()}>
            {formatDate(data.pubDate)}
          </time>
          <span class="sep" aria-hidden="true">/</span>
          <span>{readMins} min read</span>
          {data.tags.length > 0 && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span>{data.tags.join(' · ')}</span>
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Article body -->
    <div class="wrap article-body-wrap">
      <div class="prose">
        <Content />
      </div>

      <!-- Bottom of every article: sign-up + support -->
      <div class="post-end">
        <NewsletterSignup />
        <CoffeeCard />
      </div>

      <nav class="article-end-nav" aria-label="More writing">
        <a class="link-arrow" href="/writing">
          <Icon name="arrow-right" size={15} />
          All {newsletter.name} articles
        </a>

        {
          others.length > 0 && (
            <div class="related">
              <p class="related-label micro">Keep reading</p>
              <div class="related-grid">
                {others.map((other) => <ArticleCard article={other} showDescription={false} />)}
              </div>
            </div>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .article-kicker a.back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    transition: color var(--dur) var(--ease);
  }

  .article-kicker a.back-link:hover {
    color: var(--accent);
  }

  .article-kicker a.back-link svg {
    transform: rotate(180deg);
  }

  .post-end {
    margin-top: 3rem;
  }

  .article-end-nav {
    margin-top: 3.2rem;
    display: grid;
    gap: 2.2rem;
  }

  .related-label {
    color: var(--faint);
    margin: 0 0 0.9rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  @media (max-width: 720px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
