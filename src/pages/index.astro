---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MiniProjectCard from '../components/MiniProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site, newsletter, contact, booking, social, rootUrl } from '../site.config';
import { featuredGithubProjects } from '../data/github-projects';
import { getCollection, type CollectionEntry } from 'astro:content';

const hasBooking = booking.url.length > 0;

// Order the selected work deliberately (by project id).
const projectOrder = ['kai', 'education-platform', 'hyperran'];
const allProjects = await getCollection('projects');
const projectsById = new Map(allProjects.map((p) => [p.id, p]));
const selectedProjects = projectOrder
  .map((id) => projectsById.get(id))
  .filter((p): p is CollectionEntry<'projects'> => Boolean(p));

const allWriting = (await getCollection('writing'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestWriting = allWriting.slice(0, 3);

const title = `${site.name} — ${site.role}`;
---

<BaseLayout title={title} description={site.metaDescription}>
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="hero-eyebrow">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="mono">Lead AI Engineer · {site.location}</span>
          </div>

          <h1 class="hero-title">
            <span class="hero-name">Abd Bastola<span class="dot">.</span></span>
            <span class="hero-role">
              Lead AI Engineer building reliable enterprise AI systems.
            </span>
          </h1>

          <p class="hero-lead">
            I design and deliver production-ready AI agents, RAG systems and
            intelligent platforms for real-world teams — with a focus on{' '}
            <strong>evaluation</strong>, <strong>governance</strong> and{' '}
            <strong>measurable value</strong>.
          </p>

          <div class="hero-actions">
            <a class="btn btn--primary" href={rootUrl('/work')}>
              View selected work
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="btn btn--ghost" href={rootUrl('/writing')}>
              Read {newsletter.name}
              <Icon name="arrow-up-right" size={15} />
            </a>
          </div>

          <div class="currently">
            <span aria-hidden="true"></span>
            <p>
              <strong>Currently</strong> — Building and delivering enterprise AI
              systems in {site.location}.
            </p>
          </div>
        </div>

        <figure class="hero-portrait">
          <img
            src={rootUrl('/images/abd-bastola.jpg')}
            alt="Portrait of Abd Bastola"
            width="480"
            height="480"
            loading="eager"
          />
          <figcaption>
            {site.name} · {site.location}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Newsletter sign-up (after the first section) ────────── -->
  <div class="wrap" style="margin-block: clamp(1rem, 3vw, 2rem);">
    <NewsletterSignup />
  </div>

  <!-- ── Selected work ────────────────────────────────────────── -->
  <section class="section" aria-labelledby="selected-work">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">Selected work</span>
          <h2 class="section-title" id="selected-work" style="margin-top: 0.8rem;">
            Systems built for real organisations
          </h2>
        </div>
        <a class="link-arrow" href={rootUrl('/work')}>
          All work
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div class="project-grid">
        {
          selectedProjects.map((project, i) => (
            <ProjectCard project={project} index={String(i + 1).padStart(2, '0')} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Latest writing ───────────────────────────────────────── -->
  <section class="section section--rule" aria-labelledby="latest-writing">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">Reliable AI — newsletter</span>
          <h2 class="section-title" id="latest-writing" style="margin-top: 0.8rem;">
            Latest writing
          </h2>
          <p class="lede" style="margin-top: 0.7rem;">
            {newsletter.tagline}
          </p>
        </div>
        <a class="link-arrow" href={rootUrl('/writing')}>
          All articles
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div class="issue-list">
        {latestWriting.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <!-- ── Open source & builds (from GitHub) ───────────────────── -->
  <section class="section section--rule" aria-labelledby="open-source">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">GitHub</span>
          <h2 class="section-title" id="open-source" style="margin-top: 0.8rem;">
            Open source &amp; builds
          </h2>
          <p class="lede" style="margin-top: 0.7rem;">
            Real repositories — agents, GraphRAG experiments, reinforcement
            learning for RAN and automation tooling.
          </p>
        </div>
        <a
          class="link-arrow"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          All repositories
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>

      <div class="mini-project-grid">
        {
          featuredGithubProjects.slice(0, 6).map((project) => (
            <MiniProjectCard project={project} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Get in touch / schedule ──────────────────────────────── -->
  <section class="section section--rule" aria-labelledby="get-in-touch">
    <div class="wrap two-col">
      <div>
        <span class="kicker">Get in touch</span>
        <h2 class="section-title" id="get-in-touch" style="margin: 0.8rem 0 0.9rem;">
          Let’s talk about your AI systems
        </h2>
        <p class="lede">
          Designing an agent, fixing a RAG pipeline, planning evaluation and
          governance, or hiring — send a message and I’ll reply personally.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={rootUrl('/contact')}>
            Get in touch
            <Icon name="arrow-right" size={16} />
          </a>
          {
            hasBooking ? (
              <a class="btn btn--ghost" href={booking.url} target="_blank" rel="noopener noreferrer">
                <Icon name="calendar" size={15} />
                {booking.label}
              </a>
            ) : (
              <a class="btn btn--ghost" href={`mailto:${contact.email}`}>
                <Icon name="mail" size={15} />
                {contact.email}
              </a>
            )
          }
        </div>
      </div>

      <div class="card contact-teaser">
        <span class="kicker kicker--plain">Contact</span>
        <ul class="contact-teaser-list">
          <li>
            <span class="mono label">Email</span>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
          <li>
            <span class="mono label">Phone</span>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
          </li>
          <li>
            <span class="mono label">LinkedIn</span>
            <a href={social.linkedin} target="_blank" rel="noopener noreferrer">abda-bastola</a>
          </li>
          <li>
            <span class="mono label">GitHub</span>
            <a href={social.github} target="_blank" rel="noopener noreferrer">adonishhh772</a>
          </li>
          <li>
            <span class="mono label">Based</span>
            <span>{contact.location}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-name {
    display: block;
  }

  .hero-name .dot {
    color: var(--accent);
  }

  .currently {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-top: 2.4rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--surface-1);
    max-width: max-content;
  }

  .currently > span:first-child {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.55rem;
  }

  .currently p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .currently strong {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-block;
    margin-right: 0.55rem;
    color: var(--accent);
  }

  /* Hero layout with portrait */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-portrait {
    margin: 0;
    justify-self: end;
    width: min(100%, 320px);
  }

  .hero-portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--hairline-strong);
    box-shadow: 0 0 0 10px var(--accent-soft), 0 24px 60px -40px var(--shadow-accent);
  }

  .hero-portrait figcaption {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    text-align: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      justify-self: start;
      width: min(100%, 260px);
    }
  }

  /* GitHub project strip */
  .mini-project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 980px) {
    .mini-project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .mini-project-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Contact teaser card */
  .contact-teaser {
    padding: 1.5rem 1.5rem 1.7rem;
    align-self: start;
  }

  .contact-teaser-list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .contact-teaser-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.6rem;
  }

  .contact-teaser-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .contact-teaser-list .label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .contact-teaser-list a,
  .contact-teaser-list span:last-child {
    color: var(--text-soft);
    font-size: 0.9rem;
    text-align: right;
    transition: color var(--dur) var(--ease);
  }

  .contact-teaser-list a:hover {
    color: var(--accent);
  }
</style>
