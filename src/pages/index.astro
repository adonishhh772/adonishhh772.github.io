---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MiniProjectCard from '../components/MiniProjectCard.astro';
import StatsBand from '../components/StatsBand.astro';
import Icon from '../components/Icon.astro';
import Observatory from '../components/observatory/Observatory.astro';
import { site, hero, newsletter, contact, booking, social, rootUrl } from '../site.config';
import { featuredGithubProjects } from '../data/github-projects';
import { getCollection, type CollectionEntry } from 'astro:content';

const hasBooking = booking.url.length > 0;

// Order the selected work deliberately (by project id).
const projectOrder = ['kai', 'education-platform', 'hyperran'];
const allProjects = await getCollection('projects');
const projectsById = new Map(allProjects.map((p) => [p.id, p]));
const selectedProjects = projectOrder
  .map((id) => projectsById.get(id))
  .filter((p): p is CollectionEntry<'projects'> => Boolean(p));

const allWriting = (await getCollection('writing'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredArticle = allWriting[0];
const latestWriting = allWriting.slice(0, 3);

/**
 * The Work pavilion shows the real selected projects. Titles, summaries and
 * themes come from the collection, so the exhibits can never go stale.
 */
const exhibits = selectedProjects.map((project, index) => ({
  id: project.id,
  index: index + 1,
  eyebrow: project.data.tag,
  title: project.data.shortTitle,
  body: project.data.summary,
  facts: [
    { k: 'Themes', v: project.data.themes.slice(0, 3).join(' · ') },
    { k: 'Reading', v: project.data.readingTime },
  ],
  href: rootUrl(`/work/${project.id}/`),
  linkLabel: 'Read case study',
}));

const title = `${site.name} — ${site.role}`;
---

<BaseLayout title={title} description={site.metaDescription}>
  <!-- ── Hero: editorial introduction + the observatory ─────────────── -->
  <section class="hero">
    <div class="wrap wrap--wide hero-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="mono">{hero.eyebrow}</span>
          </p>

          <h1 class="hero-title">
            <span class="hero-name">{site.name}<span class="dot">.</span></span>
            <span class="hero-role">{hero.headline}</span>
          </h1>

          <p class="hero-lead">{hero.lead}</p>

          <div class="hero-actions">
            <a class="btn btn--primary" href={rootUrl(hero.primary.href)}>
              {hero.primary.label}
              <Icon name="arrow-right" size={16} />
            </a>
            <a class="btn btn--ghost" href={rootUrl(hero.secondary.href)}>
              {hero.secondary.label}
              <Icon name="arrow-up-right" size={15} />
            </a>
          </div>

          <p class="currently">
            <span aria-hidden="true"></span>
            <span>
              <strong>Currently</strong> {hero.currently}
            </span>
          </p>
        </div>

        <Observatory exhibits={exhibits} />
      </div>
    </div>
  </section>

  <!-- ── By the numbers ──────────────────────────────────────────────── -->
  <StatsBand />

  <!-- ── Selected work ───────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="selected-work">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">Selected work</span>
          <h2 class="section-title" id="selected-work" style="margin-top: 0.7rem;">
            Systems built for real organisations
          </h2>
          <p class="lede" style="margin-top: 0.6rem;">
            Three engagements, each documented end to end: the problem, my
            contribution, the architecture and the outcome.
          </p>
        </div>
        <a class="link-arrow" href={rootUrl('/work')}>
          All work
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      <div class="project-grid">
        {
          selectedProjects.map((project, i) => (
            <ProjectCard
              project={project}
              index={String(i + 1).padStart(2, '0')}
              delay={i * 80}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Writing ─────────────────────────────────────────────────────── -->
  <section class="section section--rule" aria-labelledby="latest-writing">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">Newsletter — {newsletter.name}</span>
          <h2 class="section-title" id="latest-writing" style="margin-top: 0.7rem;">
            Latest writing
          </h2>
          <p class="lede" style="margin-top: 0.6rem;">
            {newsletter.tagline}
          </p>
        </div>
        <a class="link-arrow" href={rootUrl('/writing')}>
          All articles
          <Icon name="arrow-right" size={15} />
        </a>
      </div>

      {
        featuredArticle && (
          <article class="feature card" data-reveal>
            <div class="feature-body">
              <span class="kicker kicker--plain">
                {featuredArticle.data.issue
                  ? `Issue ${String(featuredArticle.data.issue).padStart(2, '0')}`
                  : 'Latest note'}
              </span>
              <h3 class="feature-title">
                <a href={rootUrl(`/writing/${featuredArticle.id}/`)}>
                  {featuredArticle.data.title}
                </a>
              </h3>
              <p class="feature-desc">{featuredArticle.data.description}</p>
              <ul class="issue-tags" aria-label="Topics">
                {featuredArticle.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
            <a
              class="btn btn--primary"
              href={rootUrl(`/writing/${featuredArticle.id}/`)}
            >
              Read this issue
              <Icon name="arrow-right" size={15} />
            </a>
          </article>
        )
      }

      <div class="issue-list" style="margin-top: 1rem;">
        {
          latestWriting.slice(1).map((article, i) => (
            <ArticleCard article={article} delay={i * 70} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Open source & builds (from GitHub) ──────────────────────────── -->
  <section class="section section--rule" aria-labelledby="open-source">
    <div class="wrap">
      <div class="section-head-row">
        <div>
          <span class="kicker">GitHub</span>
          <h2 class="section-title" id="open-source" style="margin-top: 0.7rem;">
            Open source &amp; builds
          </h2>
          <p class="lede" style="margin-top: 0.6rem;">
            Real repositories — agents, GraphRAG experiments, reinforcement
            learning for RAN and automation tooling.
          </p>
        </div>
        <a
          class="link-arrow"
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          All repositories
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>

      <div class="mini-project-grid">
        {
          featuredGithubProjects.slice(0, 6).map((project, i) => (
            <MiniProjectCard project={project} delay={i * 60} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Newsletter sign-up ──────────────────────────────────────────── -->
  <div class="wrap">
    <NewsletterSignup />
  </div>

  <!-- ── Get in touch / schedule ─────────────────────────────────────── -->
  <section class="section" aria-labelledby="get-in-touch">
    <div class="wrap two-col">
      <div>
        <span class="kicker">Get in touch</span>
        <h2 class="section-title" id="get-in-touch" style="margin: 0.7rem 0 0.8rem;">
          Let’s talk about your AI systems
        </h2>
        <p class="lede">
          Designing an agent, fixing a RAG pipeline, planning evaluation and
          governance, or hiring — send a message and I’ll reply personally.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href={rootUrl('/contact')}>
            Get in touch
            <Icon name="arrow-right" size={16} />
          </a>
          {
            hasBooking ? (
              <a class="btn btn--ghost" href={booking.url} target="_blank" rel="noopener noreferrer">
                <Icon name="calendar" size={15} />
                {booking.label}
              </a>
            ) : (
              <a class="btn btn--ghost" href={`mailto:${contact.email}`}>
                <Icon name="mail" size={15} />
                {contact.email}
              </a>
            )
          }
        </div>
      </div>

      <div class="card contact-teaser">
        <span class="kicker kicker--plain">Contact</span>
        <ul class="contact-teaser-list">
          <li>
            <span class="mono label">Email</span>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
          <li>
            <span class="mono label">Phone</span>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
          </li>
          <li>
            <span class="mono label">LinkedIn</span>
            <a href={social.linkedin} target="_blank" rel="noopener noreferrer">abda-bastola</a>
          </li>
          <li>
            <span class="mono label">GitHub</span>
            <a href={social.github} target="_blank" rel="noopener noreferrer">adonishhh772</a>
          </li>
          <li>
            <span class="mono label">Based</span>
            <span>{contact.location}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Featured writing: one issue gets the full editorial treatment. */
  .feature {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.2rem 2rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    overflow: hidden;
  }

  .feature::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--signal), transparent 88%);
  }

  .feature-body {
    flex: 1 1 22rem;
    min-width: 0;
  }

  .feature-title {
    margin: 0.7rem 0 0.6rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 8, 'WONK' 1;
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .feature-title a {
    transition: color var(--dur-2) var(--ease-out);
  }

  .feature:hover .feature-title a {
    color: var(--accent);
  }

  .feature-desc {
    margin: 0 0 0.8rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 62ch;
  }

  .mini-project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 980px) {
    .mini-project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .mini-project-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-teaser {
    padding: 1.4rem 1.4rem 1.6rem;
    align-self: start;
  }

  .contact-teaser-list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .contact-teaser-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.55rem;
  }

  .contact-teaser-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .contact-teaser-list .label {
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .contact-teaser-list a,
  .contact-teaser-list span:last-child {
    color: var(--text-soft);
    font-size: 0.9rem;
    text-align: right;
    transition: color var(--dur-2) var(--ease-out);
  }

  .contact-teaser-list a:hover {
    color: var(--accent);
  }

  /* Hero copy: the last line of the lead should never be a lone word. */
  .hero-copy :global(.hero-lead) {
    text-wrap: pretty;
  }
</style>
