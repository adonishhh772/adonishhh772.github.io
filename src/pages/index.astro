---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MiniProjectCard from '../components/MiniProjectCard.astro';
import StatsBand from '../components/StatsBand.astro';
import Icon from '../components/Icon.astro';
import { site, hero, newsletter, contact, booking, social, rootUrl } from '../site.config';
import { featuredGithubProjects } from '../data/github-projects';
import { getCollection, type CollectionEntry } from 'astro:content';

const hasBooking = booking.url.length > 0;

// Order the selected work deliberately (by project id).
const projectOrder = ['kai', 'education-platform', 'hyperran'];
const allProjects = await getCollection('projects');
const projectsById = new Map(allProjects.map((p) => [p.id, p]));
const selectedProjects = projectOrder
  .map((id) => projectsById.get(id))
  .filter((p): p is CollectionEntry<'projects'> => Boolean(p));

const allWriting = (await getCollection('writing'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredArticle = allWriting[0];
const latestWriting = allWriting.slice(1, 4);

const title = `${site.name} — ${site.role}`;
---

<BaseLayout
  title={title}
  description={site.metaDescription}
  destination="campus"
  surface="welcome"
  backHref="/"
>
  {/*
    In world mode this card is the reading surface beside the campus; in
    simple mode it is the top of an ordinary page and the sections in the
    `fallback` slot follow it. The long homepage lives there, so the world
    stays the interface while the page remains complete for search engines
    and for anyone without WebGL.
  */}
  <section class="welcome" aria-labelledby="welcome-title">
    <p class="welcome-eyebrow">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="mono">{hero.eyebrow}</span>
    </p>

    <h1 class="welcome-name" id="welcome-title">
      {site.name}<span class="dot">.</span>
    </h1>
    <p class="welcome-headline">{hero.headline}</p>
    <p class="welcome-lead">{hero.lead}</p>

    <ul class="welcome-doors">
      <li>
        <a href={rootUrl('/cv/')}>
          <span class="door-mark" aria-hidden="true"><Icon name="user" size={15} /></span>
          <span class="door-body">
            <strong>Curriculum vitae</strong>
            <span>Experience, skills, education — print or save as PDF</span>
          </span>
          <Icon name="arrow-right" size={15} />
        </a>
      </li>
      <li>
        <a href={rootUrl('/work/')}>
          <span class="door-mark" aria-hidden="true"><Icon name="grid" size={15} /></span>
          <span class="door-body">
            <strong>Projects</strong>
            <span>Three case studies, from problem to documented outcome</span>
          </span>
          <Icon name="arrow-right" size={15} />
        </a>
      </li>
      <li>
        <a href={rootUrl('/writing/')}>
          <span class="door-mark" aria-hidden="true"><Icon name="document" size={15} /></span>
          <span class="door-body">
            <strong>Reliable AI</strong>
            <span>{allWriting.length} published issues on production AI</span>
          </span>
          <Icon name="arrow-right" size={15} />
        </a>
      </li>
      <li>
        <a href={rootUrl('/contact/')}>
          <span class="door-mark" aria-hidden="true"><Icon name="mail" size={15} /></span>
          <span class="door-body">
            <strong>Contact</strong>
            <span>Email, LinkedIn and the newsletter</span>
          </span>
          <Icon name="arrow-right" size={15} />
        </a>
      </li>
    </ul>

    <p class="welcome-note">
      <strong>Currently</strong>
      {hero.currently}
    </p>
  </section>

  <Fragment slot="fallback">
    <section class="section" aria-labelledby="selected-work">
      <div class="wrap">
        <div class="section-head-row">
          <div>
            <span class="kicker">Selected work</span>
            <h2 class="section-title" id="selected-work" style="margin-top: 0.7rem;">
              Systems built for real organisations
            </h2>
            <p class="lede" style="margin-top: 0.6rem;">
              Three engagements, each documented end to end: the problem, my
              contribution, the architecture and the outcome.
            </p>
          </div>
          <a class="link-arrow" href={rootUrl('/work/')}>
            All work
            <Icon name="arrow-right" size={15} />
          </a>
        </div>

        <div class="project-grid">
          {
            selectedProjects.map((project, i) => (
              <ProjectCard
                project={project}
                index={String(i + 1).padStart(2, '0')}
                delay={i * 80}
              />
            ))
          }
        </div>
      </div>
    </section>

    <StatsBand />

    <section class="section section--rule" aria-labelledby="latest-writing">
      <div class="wrap">
        <div class="section-head-row">
          <div>
            <span class="kicker">Newsletter — {newsletter.name}</span>
            <h2 class="section-title" id="latest-writing" style="margin-top: 0.7rem;">
              Latest writing
            </h2>
            <p class="lede" style="margin-top: 0.6rem;">{newsletter.tagline}</p>
          </div>
          <a class="link-arrow" href={rootUrl('/writing/')}>
            All articles
            <Icon name="arrow-right" size={15} />
          </a>
        </div>

        {
          featuredArticle && (
            <article class="feature card" data-reveal>
              <div class="feature-body">
                <span class="kicker kicker--plain">
                  {featuredArticle.data.issue
                    ? `Issue ${String(featuredArticle.data.issue).padStart(2, '0')}`
                    : 'Latest note'}
                </span>
                <h3 class="feature-title">
                  <a href={rootUrl(`/writing/${featuredArticle.id}/`)}>
                    {featuredArticle.data.title}
                  </a>
                </h3>
                <p class="feature-desc">{featuredArticle.data.description}</p>
                <ul class="issue-tags" aria-label="Topics">
                  {featuredArticle.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <a class="btn btn--primary" href={rootUrl(`/writing/${featuredArticle.id}/`)}>
                Read this issue
                <Icon name="arrow-right" size={15} />
              </a>
            </article>
          )
        }

        <div class="issue-list" style="margin-top: 1rem;">
          {latestWriting.map((article, i) => <ArticleCard article={article} delay={i * 70} />)}
        </div>
      </div>
    </section>

    <section class="section section--rule" aria-labelledby="open-source">
      <div class="wrap">
        <div class="section-head-row">
          <div>
            <span class="kicker">GitHub</span>
            <h2 class="section-title" id="open-source" style="margin-top: 0.7rem;">
              Open source &amp; builds
            </h2>
            <p class="lede" style="margin-top: 0.6rem;">
              Real repositories — agents, GraphRAG experiments, reinforcement
              learning for RAN and automation tooling.
            </p>
          </div>
          <a class="link-arrow" href={rootUrl('/open-source/')}>
            All repositories
            <Icon name="arrow-right" size={15} />
          </a>
        </div>

        <div class="mini-project-grid">
          {
            featuredGithubProjects.slice(0, 6).map((project, i) => (
              <MiniProjectCard project={project} delay={i * 60} />
            ))
          }
        </div>
      </div>
    </section>

    <div class="wrap">
      <NewsletterSignup />
    </div>

    <section class="section" aria-labelledby="get-in-touch">
      <div class="wrap two-col">
        <div>
          <span class="kicker">Get in touch</span>
          <h2 class="section-title" id="get-in-touch" style="margin: 0.7rem 0 0.8rem;">
            Let’s talk about your AI systems
          </h2>
          <p class="lede">
            Designing an agent, fixing a RAG pipeline, planning evaluation and
            governance, or hiring — send a message and I’ll reply personally.
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary" href={rootUrl('/contact/')}>
              Get in touch
              <Icon name="arrow-right" size={16} />
            </a>
            {
              hasBooking ? (
                <a class="btn btn--ghost" href={booking.url} target="_blank" rel="noopener noreferrer">
                  <Icon name="calendar" size={15} />
                  {booking.label}
                </a>
              ) : (
                <a class="btn btn--ghost" href={`mailto:${contact.email}`}>
                  <Icon name="mail" size={15} />
                  {contact.email}
                </a>
              )
            }
          </div>
        </div>

        <div class="card contact-teaser">
          <span class="kicker kicker--plain">Contact</span>
          <ul class="contact-teaser-list">
            <li>
              <span class="mono label">Email</span>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li>
              <span class="mono label">Phone</span>
              <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
            </li>
            <li>
              <span class="mono label">LinkedIn</span>
              <a href={social.linkedin} target="_blank" rel="noopener noreferrer">abda-bastola</a>
            </li>
            <li>
              <span class="mono label">GitHub</span>
              <a href={social.github} target="_blank" rel="noopener noreferrer">adonishhh772</a>
            </li>
            <li>
              <span class="mono label">Based</span>
              <span>{contact.location}</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </Fragment>
</BaseLayout>

<style>
  .welcome-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(0.9rem, 2vw, 1.4rem);
  }

  .welcome-eyebrow .mono {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .welcome-name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 8, 'WONK' 1;
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 620;
    line-height: 1;
    letter-spacing: -0.028em;
  }

  .welcome-name .dot {
    color: var(--accent);
  }

  .welcome-headline {
    margin: 0 0 1rem;
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    line-height: 1.28;
    letter-spacing: -0.012em;
    font-weight: 450;
    color: var(--text-soft);
    max-width: 26ch;
    text-wrap: balance;
  }

  .welcome-lead {
    margin: 0 0 clamp(1.2rem, 2.4vw, 1.8rem);
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  /* The doors are the point: every core destination, one tap away. */
  .welcome-doors {
    list-style: none;
    margin: 0 0 clamp(1.2rem, 2.4vw, 1.8rem);
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .welcome-doors a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface-1);
    transition: border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }

  .welcome-doors a:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    transform: translateX(2px);
  }

  .door-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .door-body {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .door-body strong {
    font-size: 0.95rem;
    font-weight: 560;
    color: var(--text);
  }

  .door-body span {
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .welcome-doors svg:last-child {
    color: var(--faint);
  }

  .welcome-note {
    margin: 0;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--signal-line);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface-1);
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .welcome-note strong {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    margin-right: 0.45rem;
  }
</style>
