---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, contact, booking, social, rootUrl, absoluteUrl } from '../site.config';

const hasForm = contact.formAccessKey.length > 0;
const hasBooking = booking.url.length > 0;
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent('Hello Abd')}`;

const title = 'Contact — Abd Bastola';
const description = `Get in touch with ${site.name} — email, contact form or schedule a 30-minute meeting about enterprise AI agents, RAG systems and AI delivery.`;
---

<BaseLayout title={title} description={description}>
  <section class="page-head">
    <div class="wrap">
      <span class="kicker">Contact</span>
      <h1 class="display display--page" style="margin-top: 0.9rem;">
        Get in touch
      </h1>
      <p class="lede">
        Whether you’re designing an AI system, stuck on delivery, hiring, or
        just want to compare notes on agents and RAG — I read everything and
        reply personally.
      </p>
      <div class="page-head-actions">
        {
          hasBooking ? (
            <a class="btn btn--primary" href={booking.url} target="_blank" rel="noopener noreferrer">
              <Icon name="calendar" size={16} />
              {booking.label}
            </a>
          ) : (
            <a class="btn btn--primary" href={mailto}>
              <Icon name="mail" size={16} />
              Email me
            </a>
          )
        }
        <a class="btn btn--ghost" href={social.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" size={15} />
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        {
          hasForm ? (
            <form class="card contact-form" id="contact-form" method="post" action={contact.formEndpoint}>
              <span class="kicker kicker--plain">Send a message</span>
              <input type="hidden" name="access_key" value={contact.formAccessKey} />
              <input type="hidden" name="subject" value="New message from adonishhh772.github.io" />
              <input type="hidden" name="from_name" value="Website contact form" />
              <input type="hidden" name="redirect" value={absoluteUrl('/thanks')} />
              {/* Honeypot for bots — humans never see or fill this. */}
              <input
                type="checkbox"
                name="botcheck"
                class="hp-field"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />
              <div class="field">
                <label for="contact-name">Your name</label>
                <input class="signup-input" id="contact-name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" />
              </div>
              <div class="field">
                <label for="contact-email">Email</label>
                <input class="signup-input" id="contact-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
              </div>
              <div class="field">
                <label for="contact-message">Message</label>
                <textarea
                  class="signup-input contact-textarea"
                  id="contact-message"
                  name="message"
                  rows="6"
                  required
                  placeholder="A sentence or two about what you need help with…"
                ></textarea>
              </div>
              <button class="btn btn--primary" type="submit">Send message</button>
              <p class="form-status" id="contact-status" role="status" aria-live="polite">
                Goes straight to my inbox — I usually reply within a day or two.
              </p>
            </form>
          ) : (
            <div class="card contact-fallback">
              <span class="kicker kicker--plain">Email</span>
              <h2 class="h3-title" style="margin: 0.9rem 0 0.6rem;">
                The quickest route is email
              </h2>
              <p class="muted" style="margin-bottom: 1.4rem;">
                The contact form isn’t connected yet — email me directly and
                I’ll get back to you personally.
              </p>
              <div class="hero-actions" style="margin-top: 0;">
                <a class="btn btn--primary" href={mailto}>
                  <Icon name="mail" size={16} />
                  {contact.email}
                </a>
              </div>
            </div>
          )
        }

        {
          hasForm && (
            <script is:inline>
              (function () {
                var form = document.getElementById('contact-form');
                var status = document.getElementById('contact-status');
                if (!form || !status) return;

                form.addEventListener('submit', function (event) {
                  event.preventDefault();
                  var button = form.querySelector('button[type="submit"]');
                  if (button) button.disabled = true;
                  status.textContent = 'Sending…';

                  fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { Accept: 'application/json' },
                  })
                    .then(function (res) {
                      return res.json().catch(function () {
                        return {};
                      });
                    })
                    .then(function (data) {
                      if (data && data.success) {
                        form.reset();
                        status.textContent =
                          'Thanks — your message is on its way. I’ll reply to your email soon.';
                        status.classList.add('form-status--ok');
                      } else {
                        status.textContent =
                          'Something went wrong sending that. Please email abdabastola97@gmail.com instead.';
                        status.classList.add('form-status--error');
                      }
                    })
                    .catch(function () {
                      status.textContent =
                        'Network problem — please email abdabastola97@gmail.com instead.';
                      status.classList.add('form-status--error');
                    })
                    .finally(function () {
                      if (button) button.disabled = false;
                    });
                });
              })();
            </script>
          )
        }
      </div>

      <aside class="contact-aside" aria-label="Other ways to reach me">
        <div class="card aside-card">
          <span class="kicker kicker--plain">{hasBooking ? 'Schedule' : 'Availability'}</span>
          <h2 class="h3-title" style="margin: 0.9rem 0 0.6rem;">
            {hasBooking ? booking.heading : 'Arrange a call by email'}
          </h2>
          <p class="muted" style="font-size: 0.92rem; line-height: 1.65; margin-bottom: 1.2rem;">
            {hasBooking
              ? booking.copy
              : 'My scheduling link is coming soon — send me a note with a couple of times that suit you and I’ll confirm.'}
          </p>
          {
            hasBooking ? (
              <a class="btn btn--ghost btn--small" href={booking.url} target="_blank" rel="noopener noreferrer">
                <Icon name="calendar" size={14} />
                {booking.label}
                <Icon name="arrow-up-right" size={13} />
              </a>
            ) : (
              <a class="btn btn--ghost btn--small" href={mailto}>
                <Icon name="mail" size={14} />
                Email me times
              </a>
            )
          }
        </div>

        <div class="card aside-card">
          <span class="kicker kicker--plain">Direct</span>
          <ul class="contact-list">
            <li>
              <a href={`mailto:${contact.email}`}>
                <Icon name="mail" size={15} />
                <span>{contact.email}</span>
              </a>
            </li>
            <li>
              <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>
                <Icon name="phone" size={15} />
                <span>{contact.phone}</span>
              </a>
            </li>
            <li>
              <a href={social.linkedin} target="_blank" rel="noopener noreferrer">
                <Icon name="linkedin" size={15} />
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a href={social.github} target="_blank" rel="noopener noreferrer">
                <Icon name="github" size={15} />
                <span>GitHub</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="card aside-card aside-card--line">
          <span class="status-dot" aria-hidden="true"></span>
          <p>
            <strong>{contact.location}</strong>
            <br />
            <span class="muted">Open to conversations about enterprise AI systems.</span>
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .contact-form .field {
    display: grid;
    gap: 0.45rem;
  }

  .contact-form label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact-textarea {
    resize: vertical;
    min-height: 140px;
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .form-status--ok {
    color: var(--accent);
  }

  .form-status--error {
    color: var(--danger);
  }

  .contact-fallback {
    padding: clamp(1.6rem, 3vw, 2.2rem);
  }

  .contact-aside {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .aside-card {
    padding: 1.4rem 1.4rem 1.6rem;
  }

  .aside-card--line {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: linear-gradient(160deg, var(--accent-soft), transparent 60%),
      linear-gradient(180deg, var(--bg-raised), var(--bg-sunken));
  }

  .aside-card--line p {
    margin: 0;
    line-height: 1.6;
  }

  .contact-list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .contact-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-soft);
    font-size: 0.92rem;
    transition: color var(--dur) var(--ease);
  }

  .contact-list a:hover {
    color: var(--accent);
  }
</style>
