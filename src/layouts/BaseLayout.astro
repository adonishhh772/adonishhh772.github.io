---
// Document shell for the whole site.
//
// Every page declares *where* it is in the world and *what* document is open.
// The shell around it is the same everywhere: a persistent 3D campus, a
// floating dock, and a reading surface that holds this page's content.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
// Fraunces carries the display voice: a soft, curious serif that reads as
// "instrument" rather than "corporate". Variable, so one file covers the
// whole weight range.
import '@fontsource-variable/fraunces';
/* Preload the two faces that paint the first screen. Without this the
   fallback metrics differ enough that the swap shifts the headline and the
   lead paragraph — measured as CLS, and felt as a jolt. */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import WorldShell from '../components/world/WorldShell.astro';
import WorldChrome from '../components/world/WorldChrome.astro';
import WorldWelcome from '../components/world/WorldWelcome.astro';
import Identity from '../components/world/Identity.astro';
import { destinationMeta, type DestinationId, type SurfaceKind } from '../lib/world/destinations';
import { surfaceLabel } from '../lib/world/state';
import { site, newsletter, rootUrl, absoluteUrl } from '../site.config';
import { getCollection } from 'astro:content';
import { githubProjects } from '../data/github-projects';
import { readTimeInMinutes } from '../lib/format';

interface Props {
  title: string;
  description?: string;
  /** Use for individual articles / case studies (sets og:type). */
  type?: 'website' | 'article';
  /** Which location in the world this page belongs to. */
  destination: DestinationId;
  /** Which document is open at that location. */
  surface: SurfaceKind;
  /** Slug of the open document, when it has one. */
  surfaceId?: string;
  /** Where "Back" should go. */
  backHref?: string;
}

const {
  title,
  description = site.metaDescription,
  type = 'website',
  destination,
  surface,
  surfaceId = '',
  backHref = '/',
} = Astro.props;

/*
 * The world is built from the real content, not a hard-coded list: every
 * published article becomes a book in the library, every curated repository
 * a plaque on the workbench, every project an installation in the workshop.
 */
const articles = (await getCollection('writing'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projects = await getCollection('projects');

const worldIndex = {
  articles: articles.map((entry, index) => ({
    id: entry.id,
    label: entry.data.title,
    href: rootUrl(`/writing/${entry.id}/`),
    meta: `${entry.data.issue ? `Issue ${String(entry.data.issue).padStart(2, '0')} · ` : ''}${
      readTimeInMinutes(entry.body ?? '')
    } min`,
    order: index,
  })),
  projects: projects.map((entry) => ({
    id: entry.id,
    label: entry.data.shortTitle,
    href: rootUrl(`/work/${entry.id}/`),
    meta: entry.data.tag,
  })),
  repos: githubProjects.map((repo) => ({
    id: repo.name,
    label: repo.name,
    href: repo.url,
    meta: repo.language,
  })),
};

const documentTitle = `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const place = destinationMeta(destination);
const hasSurface = surface !== 'none';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Decide the experience before anything paints.

      JavaScript being available is what selects the world: a browser without
      it gets the semantic documents as ordinary readable pages (which is also
      what crawlers see), and a browser *with* JavaScript but no working WebGL
      gets the world's own failure screen — never a silent swap to a
      conventional portfolio.
    */}
    <script is:inline>
      (function () {
        var gl = null;
        try {
          var canvas = document.createElement('canvas');
          gl =
            canvas.getContext('webgl2') ||
            canvas.getContext('webgl') ||
            canvas.getContext('experimental-webgl');
          if (gl) {
            var lose = gl.getExtension('WEBGL_lose_context');
            if (lose) lose.loseContext();
          }
          document.documentElement.dataset.mode = 'world';
          document.documentElement.dataset.webgl = gl ? 'yes' : 'no';
        } catch (error) {
          /* No scripting environment we can trust: the readable pages stand. */
          document.documentElement.dataset.mode = 'simple';
          document.documentElement.dataset.webgl = 'no';
        }
        try {
          var theme = localStorage.getItem('theme');
          var prefersLight =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.dataset.theme = theme || (prefersLight ? 'light' : 'dark');
        } catch (error) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl('/images/abd-bastola.jpg')} />
    <meta property="og:image:alt" content={`Portrait of ${site.name}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl('/images/abd-bastola.jpg')} />

    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href={rootUrl('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={rootUrl('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="256x256" href={rootUrl('/favicon-256.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={rootUrl('/apple-touch-icon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${newsletter.name} — RSS`}
      href={newsletter.rssPath}
    />
    <link rel="sitemap" href={rootUrl('/sitemap-index.xml')} />
    <meta name="robots" content="index, follow" />
    <ClientRouter />
    <script
      type="application/json"
      data-world-index
      set:html={JSON.stringify(worldIndex).replace(/</g, '\\u003c')}
    />
  </head>

  <body
    class="world-body"
    data-destination={destination}
    data-surface={surface}
    data-surface-id={surfaceId}
    data-panel={place.panel}
  >
    <a class="skip-link" href="#surface-content">Skip to content</a>

    <Header />
    <WorldShell />
    <WorldChrome />
    <WorldWelcome />
    {destination === 'campus' && !hasSurface && <Identity />}

    <main
      id="surface-content"
      class="surface-host"
      data-surface-host
      data-surface-panel={surface}
    >
      {
        hasSurface && (
          <div class="surface-frame">
            <div class="surface-bar">
              <a class="surface-back" href={rootUrl(backHref)} data-surface-back>
                <Icon name="arrow-right" size={14} />
                {surface === 'article' || surface === 'project' ? 'Archive' : 'Back'}
              </a>
              <p class="surface-where mono">
                <span>{place.name}</span>
                <span aria-hidden="true">·</span>
                <span>{surfaceLabel(surface)}</span>
              </p>
              {/*
                The close control leaves the document and puts the visitor
                back where they were standing, without reloading anything.
                Its target is set by the shell from the recorded view.
              */}
              <button
                class="surface-close"
                type="button"
                data-surface-close
                aria-label="Close and return to the previous view"
                title="Close"
              >
                <Icon name="close" size={15} />
                <span class="surface-close-label">Close</span>
              </button>
            </div>
            <slot />
          </div>
        )
      }
      <div class="simple-only">
        <slot name="fallback" />
      </div>
    </main>

    <Footer />

    {/*
      Page controls are installed through one bundled module rather than
      per-page inline scripts: the client router only ever executes an inline
      script once per session, so a script that binds on load goes silent
      after the first navigation. This module delegates and re-initialises on
      every `astro:page-load`, with per-element guards against double binding.
    */}
    <script>
      import { watchPageControls } from '../lib/world/page-controls';
      watchPageControls();
    </script>
  </body>
</html>
